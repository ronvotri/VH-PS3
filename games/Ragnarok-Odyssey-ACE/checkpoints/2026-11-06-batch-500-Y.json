{
  "date": "2026-11-06",
  "kind": "manual_translation_delta",
  "source": "RagnarokACE-BanGiaoDich-2026-11-04.zip",
  "total": 500,
  "notes": "Đợt Y: 92 NPC 3866–3957 về Rồng Xanh Lindwurm, 371 tên thẻ 1100–1470 và 37 mô tả thẻ 640–676. Đối chiếu thuật ngữ các checkpoint U–X, bảo toàn mã, token và số; chưa thử patch trên RPCS3.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3866": "Nếu tiếng thằn lằn ấy vang từ\ntầng đáy lên tận chỗ Sol, thì\ncon quái đó phải khổng lồ lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3867": "Ê, {#0}!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3868": "Xin lỗi nha, nhưng cậu khoan\nvào tòa tháp một thời gian được không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3869": "Chuyện lần này có mùi đáng ngờ,\nxộc tận Asgard luôn ấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3870": "Tui có linh cảm ai vào đó lúc này\nsẽ chẳng còn đường trở ra.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3871": "Vừa dẹp xong lũ Khổng Lồ mà lại\ncó người bỏ mạng thì buồn lắm,\ncậu hiểu chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3872": "Tui có linh cảm ai bước vào tháp\nlúc này sẽ chẳng trở về đâu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3873": "Xin lỗi nha. Cậu đừng quay lại\ntòa tháp trong ít hôm, được không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3874": "Tui không muốn lặp lại thảm cảnh\nvới con Ma Điểu đáng nguyền rủa ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3875": "Xin cậu chờ thêm một chút nhé?\nTôi đang xử lý yêu cầu của Eirik.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3876": "Anh ấy muốn biết còn truyền thuyết\nnào nói về thằn lằn biết bay không.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3877": "Có vẻ linh cảm của tôi đã đúng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3878": "Dưới chân tháp có một sinh vật\nlẽ ra đã tuyệt chủng từ Thời Đại\nChư Thần: một con rồng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3879": "Có lẽ cậu sẽ dẫn đầu chuyến\nthám hiểm tiếp theo. Hết sức\ncẩn thận, nó rất nguy hiểm đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3880": "Và nếu cậu còn sống trở về...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3881": "Tôi RẤT muốn nghe hết chuyện\ncậu quyết đấu sinh tử với rồng,\nloài quái dữ nhất trong số dữ nhất!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3882": "TÔI NÓNG LÒNG QUÁ ĐI!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3883": "{#0}! Mani và Sol đoán trúng rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3884": "Tiếng gầm trong tháp là của\nLindwurm, loài rồng đã tuyệt chủng\ntừ hàng nghìn năm trước.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3885": "Thật khó tin thiết bị triệu hồi\nlại gọi được cả loài đã tuyệt chủng\nnhư Lindwurm, tôi biết chứ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3886": "Nhưng theo nghiên cứu của Yukino,\nđáng tiếc đó gần như chắc chắn\nlà điều đang xảy ra.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3887": "Nhờ có cảnh báo, chúng ta đã cử\nLif và Thrasir đi trinh sát thêm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3888": "Họ may mắn xác định được đại khái\ntầng mà con rồng xanh làm tổ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3889": "Nhưng phần khó nhất còn ở phía sau.\nCậu sẵn sàng chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3890": "Lindwurm làm tổ gần tầng 100,\ntheo kết quả khảo sát sơ bộ\ncủa chúng ta.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3891": "Chúng ta vẫn chưa biết chính xác\ntòa tháp có bao nhiêu tầng...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3892": "Nhưng muốn thám hiểm sâu hơn,\nchúng ta nhất định phải vượt qua\ncon rồng ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3893": "Tốt lắm. Ta thấy cậu đã hiểu\nđiều ta muốn nói rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3894": "Được rồi, {#0}! Cho con rồng\nbiết bản lĩnh của Lính Thuê\nMạnh Nhất đi nào!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3895": "Khu vực: Tháp Yggdrasil!\nMục tiêu: Rồng Xanh Lindwurm!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3896": "Ta biết muốn khám phá kỹ tòa tháp\nthì không thể chỉ đi ngắm cảnh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3897": "Nhưng không ngờ chúng ta lại phải\nđấu với rồng từ Thời Đại Chư Thần!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3898": "Nghe đây, {#0}. Con quái ấy\nvẫn lưu danh trong truyền thuyết\nbao thiên niên kỷ. Nó rất mạnh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3899": "Thậm chí có thể mạnh ngang\nmột Đại Khổng Lồ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3900": "Nhớ chuẩn bị thật kỹ để ứng phó\nvới mọi tình huống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3901": "À, {#0} {#1}! Bọn tôi đã tìm ra\nnguồn gốc tiếng gầm rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3902": "Tiếng Sol nghe thấy hẳn là\ncủa Rồng Xanh Lindwurm,\nmột con rồng huyền thoại đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3903": "Chưa biết sao một con rồng cổ\ntrong truyền thuyết lại sống\ndưới đáy tòa tháp...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3904": "Nhưng chuyện quan trọng không phải\nvì sao, mà là đánh nó thế nào\nnếu ta chạm trán!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3905": "Thế là hai chuyên gia quái vật\nlà tôi và Eirik đã nghĩ ra\nkế hoạch trị rồng rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3906": "Rồng thuộc hàng quái vật tinh anh:\nvừa khỏe, hung dữ, lại cực khôn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3907": "Không nên đối đầu trực diện\nvới loại quái vật ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3908": "Vuốt nó xé cậu thành từng mảnh,\nrồi hơi lửa nướng chín phần còn lại!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3909": "Nhưng cả rồng lẫn thần đều\nđể lộ điểm mù khi ra đòn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3910": "Lách vào điểm mù rồi tấn công,\ncậu sẽ có cơ hội hạ nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3911": "Điểm mù của Lindwurm chắc ở gần\nđôi cánh lớn, tức là hai bên sườn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3912": "Nếu đụng độ nó, tôi sẽ áp sát\nhai bên rồi tìm cách phá cánh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3913": "Rồng không bay được thì chỉ là\nthằn lằn quá khổ. Cứ nhắm đầu\nnó mà đánh đến khi gục!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3914": "Rồng Xanh Lindwurm là\nmột con quái vật huyền thoại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3915": "Đừng đối đầu trực diện\nvới loại quái vật ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3916": "Vuốt nó xé cậu thành từng mảnh,\nrồi hơi lửa nướng chín phần còn lại!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3917": "Nhưng cả rồng lẫn thần đều\nđể lộ điểm mù khi ra đòn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3918": "Lách vào điểm mù rồi tấn công,\ncậu sẽ có cơ hội hạ nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3919": "Điểm mù của Lindwurm chắc ở gần\nđôi cánh lớn, tức là hai bên sườn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3920": "Nếu đụng độ nó, tôi sẽ áp sát\nhai bên rồi tìm cách phá cánh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3921": "Rồng không bay được thì chỉ là\nthằn lằn quá khổ. Cứ nhắm đầu\nnó mà đánh đến khi gục!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3922": "Có vẻ bọn tôi vô tình gây phiền\nphức cho cậu. Xin lỗi nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3923": "Nhưng cả hai vẫn trở về nguyên vẹn,\nnên chắc phải cảm ơn cậu rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3924": "À đúng rồi! Lúc quay về, bọn tôi\nđược nhờ rẽ vào tháp vì có người\nnghe tiếng quái vật khổng lồ gầm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3925": "Đội trưởng bảo bọn tôi xác định\nđại khái tiếng đó ở tầng nào.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3926": "Bọn tôi vào sâu rồi mới nghe thấy.\nTiếng gầm phát ra từ rất xa\nphía dưới.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3927": "Bọn tôi gom hết dây thừng, buộc\nmột đầu vào cột, đầu kia treo vật\nnặng rồi thả xuống giữa cầu thang.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3928": "Nghe tiếng vật rơi, bọn tôi ước\nlượng khoảng cách từ chỗ mình\nđến nơi phát tiếng gầm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3929": "Chỉ là phỏng đoán thôi, nhưng\nchắc nó ở sau tầng 100, đúng\nnơi cậu sắp thám hiểm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3930": "Thế là bọn tôi vội về báo tin!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3931": "Ai ngờ tiếng gầm ấy không phải\nquái thường mà là RỒNG! Khiếp!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3932": "Tôi từng bảo ghét thằn lằn rồi mà!\nThứ gì giống nó cũng ghê hết!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3933": "Tôi cố nghe rõ từng tiếng nhỏ nhất,\nđể giờ tiếng gầm ấy cứ ám\ntrong đầu! Ghê quá!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3934": "Nếu từ nay tôi giật bắn mỗi khi\nnghe âm thanh na ná, tôi đổ hết\ncho lão râu ria kia!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3935": "Tại lão chẳng báo trước gì cả!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3936": "Bọn tôi gom hết dây thừng, buộc\nmột đầu vào cột, đầu kia treo vật\nnặng rồi thả xuống giữa cầu thang.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3937": "Nghe tiếng vật rơi, bọn tôi ước\nlượng khoảng cách từ chỗ mình\nđến nơi phát tiếng gầm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3938": "Chỉ là phỏng đoán thôi, nhưng\nchắc nó ở sau tầng 100, đúng\nnơi cậu sắp thám hiểm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3939": "Từ sau nhiệm vụ ngớ ngẩn ấy,\ncứ nghe gì na ná tiếng gầm\nlà tôi lại giật thót!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3940": "Dù sao sự hy sinh của tôi\ncũng có ích cho cậu, {#0}.\nThế là tốt rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3941": "Nhưng tôi vẫn ghét lão râu ria\nđó thêm một thời gian! HỨ!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3942": "Thrasir, cẩn thận lời nói nhé.\nLỡ đội trưởng nghe được\nthì khổ đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3943": "Tôi đã hoàn tất nghiên cứu theo\nyêu cầu của Eirik và báo kết quả.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3944": "Đúng như anh ấy giả định,\nThời Đại Chư Thần từng có sinh vật\nrất giống thằn lằn biết bay.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3945": "Âm thanh được mô tả gần như\ntrùng khớp với những ghi chép\nđược lưu lại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3946": "Theo giả thuyết của tôi, đó là\nLindwurm, con rồng khổng lồ\nvà cực kỳ hung dữ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3947": "Eirik và Lif đang bàn chiến thuật\nhạ nó. Cậu nên trao đổi\nvới một trong hai người.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3948": "Sắp có nhiệm vụ lớn rồi, {#0}!\nBọn tôi sẽ đợi cậu\nbình an trở về nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3949": "Mừng cậu trở lại! Vẫn nở\nnụ cười tươi như mọi khi nhỉ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3950": "À, {#0}. Linh cảm của Sol\nvà Eirik quả nhiên chính xác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3951": "Tiếng gầm trong tháp hóa ra\nlà của Lindwurm, một con rồng\ntừ Thời Đại Chư Thần!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3952": "Thật khó tin mấy cỗ máy ấy\ntriệu hồi được linh hồn\ncủa sinh vật như thế.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3953": "Nhưng nếu Yukino nói đúng,\nthì đó chính là chuyện ta đối mặt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3954": "Tôi nhận báo cáo đủ sớm để cử\ncặp đôi kỳ quặc ở quán rượu\nđi điều tra thêm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3955": "May mắn là họ xác định được\nđại khái chỗ con quái làm tổ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3956": "Nhưng còn vấn đề lớn hơn.\nVểnh tai lên nghe cho kỹ đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3957": "Có vẻ Lindwurm ở gần tầng 100,\ntheo kết quả thám hiểm sơ bộ.",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1100": "{#0}Thẻ Chúa Tể Bóng Tối",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1101": "{#0}Thẻ Chúa Tể Bóng Tối",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1102": "{#0}Thẻ Chúa Tể Bóng Tối",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1103": "{#0}Thẻ Chúa Tể Bóng Tối",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1104": "{#0}Thẻ Chúa Tể Bóng Tối",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1105": "{#0}Thẻ Móng Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1106": "{#0}Thẻ Linh Hồn Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1107": "{#0}Thẻ Bộ Đẩy Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1108": "{#0}Thẻ Cánh Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1109": "{#0}Thẻ Pha Lê Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1110": "{#0}Thẻ Diệt Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1111": "{#0}Thẻ Hagal Móng Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1112": "{#0}Thẻ Eohl Linh Hồn Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1113": "{#0}Thẻ Sigel Bộ Đẩy Rồng",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1114": "{#0}Thẻ Nide Cánh Rồng",
