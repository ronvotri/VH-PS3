  "notes": "79 NPC and 421 crafting-order names (base families); original text and metadata preserved; stock validator run.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4561": "Được rồi, {#0}! Đi bảo\ncon thằn lằn quá khổ đó thôi phun\nhơi thối làm bẩn không khí đi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4562": "Nghe rõ lệnh nhiệm vụ đây!\nKhu vực mục tiêu: “Niflheim!”\nMục tiêu: Hắc Long “Nidhoggr!!”",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4564": "Muốn tiếp tục dò tung tích\nbọn khổng lồ ở Niflheim thì\nbọn tôi phải dẹp hết vật cản.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4565": "Nó phun sương mù để nhử cậu đến.\nĐược cái bọn tôi đỡ phải\nmất công lùng nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4566": "Được rồi, {#0}! Đi bảo\ncon thằn lằn quá khổ đó thôi phun\nhơi thối làm bẩn không khí đi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4567": "Ê, {#0}! Nghe đồn cậu sắp\nmột chọi một với chính Hắc Long\ntrong truyền thuyết hả!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4568": "Từ trận đánh Lindwurm và bao nhiêu\ntruyền thuyết, tôi rút ra một điều:\nNidhoggr dữ lắm, dữ thật đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4569": "Tôi với Lif, tay sành quái vật,\nđã vắt óc nghĩ ra chiến thuật\ntrị rồng hay nhất có thể!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4570": "Nidhoggr dữ hơn cả đồng loại.\nChuyện về nó làm người ta\nsợ xanh mặt suốt mấy thế kỷ rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4571": "Như mọi con rồng, nó có vuốt,\nhơi thở kinh khủng, đuôi khỏe\nvà đủ trò khiến cậu khốn đốn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4572": "Nhưng thứ cậu phải để ý nhất\nlà đôi cánh to tướng, xấu hoắc,\nđầy hình xăm của nó!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4573": "Nghe kỹ này. Đừng tưởng nó giống\nLindwurm mà lao thẳng vào sườn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4574": "Làm thế là ăn ngay cú quật cánh\nkhổng lồ, dẹp lép như vệt bùn\ndính trên mặt đất!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4575": "...Phải canh thật, THẬT kỹ\nlúc lao vào sườn nó.\nLỡ nhịp là toi đấy, nghe chưa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4576": "Với quái thú mạnh cỡ loài rồng,\nkhó mà chỉ vào đâu rồi bảo:\n“Điểm yếu của nó đây!”",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4577": "Nhưng quái vật nào cũng có\nmột hai chỗ yếu hơn những chỗ khác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4578": "Tìm ra chỗ đó rồi dồn đòn vào đấy.\nThế thì cả con quái huyền thoại này\ncậu cũng có thể hạ được!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4579": "Cứ nhắm mấy chỗ dễ thấy nhất\ntrước rồi tính tiếp!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4580": "Nidhoggr dữ hơn cả đồng loại.\nChuyện về nó làm người ta\nsợ xanh mặt suốt mấy thế kỷ rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4581": "Như mọi con rồng, nó có vuốt,\nhơi thở kinh khủng, đuôi khỏe\nvà đủ trò khiến cậu khốn đốn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4582": "Nhưng thứ cậu phải để ý nhất\nlà đôi cánh to tướng, xấu hoắc,\nđầy hình xăm của nó!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4583": "Nghe kỹ này. Đừng tưởng nó giống\nLindwurm mà lao thẳng vào sườn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4584": "Làm thế là ăn ngay cú quật cánh\nkhổng lồ, dẹp lép như vệt bùn\ndính trên mặt đất!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4585": "...Phải canh thật, THẬT kỹ\nlúc lao vào sườn nó.\nLỡ nhịp là toi đấy, nghe chưa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4586": "Với quái thú mạnh cỡ loài rồng,\nkhó mà chỉ vào đâu rồi bảo:\n“Điểm yếu của nó đây!”",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4587": "Nhưng quái vật nào cũng có\nmột hai chỗ yếu hơn những chỗ khác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4588": "Cứ nhắm mấy chỗ dễ thấy nhất\ntrước rồi tính tiếp!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4589": "Một số tài liệu khác có nhắc đến\nmàn sương phủ khắp thành phố\nngười chết ở Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4590": "Tôi cứ đinh ninh sương từ Hvergelmir,\ncon suối lạnh tương truyền ở đó.\nRồi tôi tìm hiểu thêm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4591": "Tôi chưa từng nghĩ màn sương ấy\nlại đến từ Hắc Long.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4592": "Nhờ bản báo cáo rất tỉ mỉ của cậu\nmà tôi mới hiểu ra mọi chuyện,\n{#0}. Cảm ơn cậu!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4593": "Tương truyền Nidhoggr là một trong\nnhững con rồng cổ xưa nhất.\nNó sống sót qua cả Ragnarok.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4594": "Truyền thuyết kể nó gặm rễ Yggdrasil,\nuống máu người chết, cõng linh hồn\nkẻ ngã xuống trên lưng, và còn nữa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4595": "Chừng đó đủ thấy nó đáng sợ\nvà tàn bạo đến mức nào. Lúc đối mặt,\ncậu chớ lơ là dù chỉ một phút.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4596": "Hắc Long Nidhoggr rất cổ xưa,\nkể cả so với loài rồng.\nTương truyền nó sống qua Ragnarok.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4597": "Truyền thuyết kể nó gặm rễ Yggdrasil,\nuống máu người chết, cõng linh hồn\nkẻ ngã xuống trên lưng, và còn nữa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4598": "Chừng đó đủ thấy nó đáng sợ\nvà tàn bạo đến mức nào. Lúc đối mặt,\ncậu chớ lơ là dù chỉ một phút.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4599": "Theo ghi chép tôi đang giải mã,\nvị hiệp sĩ Glast Heim đã đi qua\nNiflheim mà chẳng gặp Nidhoggr.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4600": "Nếu giác quan của Nidhoggr nhạy bén\nnhư lời đồn, khó mà tin rằng\nnó không phát hiện vị hiệp sĩ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4601": "Tôi nghĩ hẳn còn lý do khác\nkhiến vị hiệp sĩ ấy chẳng phải\nmục tiêu đáng để nó để mắt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4602": "Lại đi diệt rồng à? Nghe nói\ncon Hắc Long lần này vừa cổ xưa\nvừa cực kỳ mạnh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4603": "Nhưng phe mình có tay diệt rồng\ncòn mạnh hơn. Anh hùng từng hạ\nVua Khổng Lồ là cậu đấy, {#0}.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4604": "Dù con rồng mạnh hơn cậu, tôi tin\nkinh nghiệm và trực giác của cậu\nđủ để bù vào chỗ chênh lệch đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4605": "Tôi tin cậu, {#0}!\nMong Vidarr phù hộ cậu!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4606": "{#0}. Nghe nói mới đó mà\ncậu đã lột da tới hai con rồng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4607": "Vậy là thêm “Kẻ Diệt Rồng”\nbên cạnh “Kẻ Diệt Khổng Lồ”\ntrong bảng danh hiệu rồi nhỉ? Ha ha!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4608": "Phen này tên cậu sẽ vang như\nsấm của Thor, lan ra tận ngoài\nvương quốc cho xem! Khá lắm, nhóc!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4609": "Cứ thế này, có ngày cậu còn\nnhiều danh hiệu hơn Đấng Toàn Phụ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4610": "Ta tự hào về cậu lắm, nhóc.\nTa cũng tự hào vì đã rèn vũ khí\ncho một anh hùng đích thực.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4611": "Nhưng đừng tưởng chỉ có\nchuyện vui, {#0}.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4612": "Hạ được con rồng là tốt,\nnhưng ta vẫn chẳng biết gì mấy\nvề phần còn lại của Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4613": "Ai biết được? Có khi trong đó\ncòn có con khiến lũ rồng\ntrông yếu xìu ấy chứ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4614": "Giữ vũ khí cho thật tốt, nghe chưa?\nCứ tìm cách tôi luyện nó\ncho mạnh hết mức có thể!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4615": "Nghe này. Với ta, đám các cậu\ncứ như cháu ruột của ta vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4616": "Hồi vào đoàn ta chẳng nghĩ nhiều.\nGiờ rèn đồ cứ như đang làm quà\ncho cả đám cháu cưng ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4617": "Phải nói là ta bắt đầu\nthích chuyện này rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4618": "Búa Thor ơi, chắc ta già rồi.\nHa ha ha ha!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4620": "Chuyện phiêu lưu hào hứng của cậu\nđã cho tôi cảm hứng thử sức\nvới một phong cách mới!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4621": "Chủ đề đợt này là “Áo Choàng\nCánh Đen”. Điểm nhấn là lông vũ.\nTất cả xoay quanh lông vũ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4622": "Chào cậu! Hôm nay tôi có\ntin vui cho cậu đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4623": "Ai ngờ thử bao vật liệu mới\nlại có kết quả! Tôi có mũ mới\nđể bán rồi. Hay chưa nào?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4624": "Ý tưởng lần này là\n“Người Mang Sừng Rồng”!\nĐầy sức hút huyền bí của loài rồng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4625": "Này! Tớ nghe hết chuyện của cậu\nlúc bọn tớ đang bì bõm\ndưới tầng hầm của Tháp rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4626": "Trời ơi, sao mấy nhiệm vụ hay\ntoàn rơi vào tay cậu thế?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4627": "Ha ha, xin lỗi, xin lỗi.\nChuyện này đâu có gì đáng cười nhỉ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4628": "Mà bảo Niflheim là cả một thế giới\ntách biệt hẳn với cõi mình\nthì cũng chẳng quá lời.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4629": "Ai cũng thấy vài nhiệm vụ ở đó\nkhó ngang, có khi còn khó hơn\ncả những trận đánh bọn khổng lồ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4630": "Nếu thấy khó quá, cứ thuê thêm\nlính đánh thuê hỗ trợ, hoặc rủ\nmấy người bạn ở Quán Rượu đi cùng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4631": "Nói giờ có lẽ hơi muộn, nhưng\nkhi gặp khó, chiến binh thực thụ\nsẽ quay về với những gì căn bản.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4632": "Đừng quên nhé, {#0}.\nTớ chắc sẽ có lúc cậu cần đến.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4633": "Ai cũng thấy vài nhiệm vụ Niflheim\nkhó ngang, có khi còn khó hơn\ncả những trận đánh bọn khổng lồ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4634": "Nếu thấy khó quá, cứ thuê thêm\nlính đánh thuê hỗ trợ, hoặc rủ\nmấy người bạn ở Quán Rượu đi cùng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4635": "Nói giờ có lẽ hơi muộn, nhưng\nkhi gặp khó, chiến binh thực thụ\nsẽ quay về với những gì căn bản.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4636": "Đừng quên nhé, {#0}.\nTớ chắc sẽ có lúc cậu cần đến.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4637": "Trước là Tháp Yggdrasil, giờ lại\nđến Niflheim. Mọi chuyện cứ khác xa\nnhững gì mình tưởng, nhỉ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4638": "Cứ tưởng đã hạ được con mạnh nhất\nthì lại có một con quái vật khác\ncòn mạnh hơn xuất hiện.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4639": "Có lẽ số phận lính đánh thuê\nlà hết lần này đến lần khác\nđối đầu kẻ mạnh hơn mình.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4640": "...Tôi nghĩ cậu nên biết chuyện này,\n{#0}, nên tôi sẽ kể.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4641": "Mani và tôi đã xuống khám phá\nsâu hơn ở những tầng dưới của Tháp.",
    "item.cpk::it_db.en.pac::it_db_name_myorder.rmsg::2088": "Glanzen Dao Katar 3-2",
