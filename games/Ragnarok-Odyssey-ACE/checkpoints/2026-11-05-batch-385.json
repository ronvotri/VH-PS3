    "menu.cpk::msg_field.en.pac::msg_room.bin::116": "Tầng dưới",
    "menu.cpk::msg_field.en.pac::msg_room.bin::118": "Chào đón mọi người",
    "menu.cpk::msg_field.en.pac::msg_room.bin::119": "Chỉ bạn bè",
    "menu.cpk::msg_field.en.pac::msg_room.bin::121": "Thiết lập",
    "menu.cpk::msg_field.en.pac::msg_room.bin::122": "Vui lòng nhập tên phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::123": "Vui lòng nhập mật khẩu.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::124": "Phong cách phòng",
    "menu.cpk::msg_field.en.pac::msg_room.bin::125": "Mật khẩu",
    "menu.cpk::msg_field.en.pac::msg_room.bin::126": "Có thể chơi đến chương {#0}.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::127": "Có thể chơi đến hạng {#0}.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1121": "Yên tâm! Mấy nhiệm vụ đầu dễ thôi,\nđể cậu quen với Vùng Đất Chia Cắt.\nCứ từ từ mà học.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1122": "Nói nhỏ nhé, Eadgils không gọi\nai bằng tên đâu, vua hay quái cũng thế,\ntrừ khi ông ấy thật sự kính trọng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1123": "Poring là lũ quái kỳ cục nhất ở\nVùng Đất Chia Cắt. Nhưng vừa tầm\nđể tập đánh, vui ra phết!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1124": "Bọn chúng cũng khá hiền.\nCứ thử đánh một bầy trước\nđể hết run tay đi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1125": "Cậu có tài, tôi biết mà!\nVới kỹ năng và lòng gan dạ ấy,\ncậu sẽ khai phá hết sức mạnh lá bùa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1126": "Orc là tộc bán nhân sống ở\nVùng Đất Chia Cắt. Lơ là một chút\nlà bị chúng đập đau điếng đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1127": "Một con đã đủ phiền rồi.\nCả bầy kéo đến thì coi chừng!\nCó đồng bọn, chúng hung hăng lắm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1128": "Ê! Gặp tên khổng lồ đầu tiên rồi hả?\nTrông thấy chắc sợ tái mặt nhỉ?\nNhưng không sao đâu!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1129": "Cứ để tôi lo! Nghe đây,\ntôi sẽ dạy cậu chiêu chiến đấu\ndữ dằn nhất mà cậu cần biết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1130": "Chiêu này dồn toàn bộ sức mạnh\nvào đòn đánh, chuyên trị quái lì.\nNó gọi là \"Chế độ Dainsleif\"!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1131": "Nhưng phải trả giá đấy!\nNó đốt sinh lực để đẩy sức mạnh\nvà tốc độ của cậu lên cực hạn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1132": "Chỉ dùng khi bí quá nhé!\nMột khi bật lên, cậu phải hạ quái\nđể nó thôi rút cạn sinh lực.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1133": "Đừng ngừng tay dù chỉ một giây!\nRõ chưa? Giỏi! Học bằng cách làm.\nRa ngoài thử ngay đi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1134": "\"Chế độ Dainsleif\" là chiêu\nchiến đấu dữ dằn nhất cậu cần biết.\nChuyên trị những con quái lì!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1135": "Nhưng phải trả giá đấy!\nNó đốt sinh lực để đẩy sức mạnh\nvà tốc độ của cậu lên cực hạn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1136": "Cách học tốt nhất là thực hành.\nRa ngoài thử ngay đi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1137": "Ê, {#0}! Bị cuốn vào vụ cãi vã\ngiữa Eadgils và Mina rồi hả?\nHai người nghĩ khác nhau hoàn toàn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1138": "Eadgils thì tùy cơ ứng biến,\ncòn Mina lúc nào cũng \"mệnh lệnh\".\nBảo sao chẳng thống nhất nổi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1139": "Chính nhà vua thuê chúng tôi xử lý\nVùng Đất Chia Cắt, cho cả pháo đài\nvà quyền tự quyết mọi chuyện.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1140": "Nhưng Hội đồng Lãnh chúa phản đối.\nThế là chúng tôi phải dưới quyền\nCận vệ Hoàng gia, lại thiếu tiếp tế.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1141": "Bực nhỉ? Chưa hết đâu!\nHội đồng còn cử Mina đến đây\nđể giám sát và \"truyền lệnh\".",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1142": "Ai ở đây mà chịu nổi chuyện đó!\nCận vệ Hoàng gia thì sao chứ?\nNgười ngoài đừng hòng sai khiến!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1143": "Cậu gặp Mina rồi đấy nhỉ?\nSuốt ngày \"danh dự\" với \"hiệp sĩ\".\nEadgils chẳng lúc nào yên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1144": "Eadgils kiên nhẫn hơn vẻ ngoài,\nnhưng Mina làm ông ấy hết chịu nổi.\nĐừng chen vào giữa họ nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1145": "Cận vệ Hoàng gia thì sao chứ?\nỞ đây chẳng ai nghe người ngoài\nlên mặt dạy đời đâu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1146": "Cậu gặp Mina rồi đấy nhỉ?\nSuốt ngày \"danh dự\" với \"hiệp sĩ\".\nEadgils chẳng lúc nào yên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1147": "Hội đồng Lãnh chúa ghét chúng tôi,\nvì chúng tôi chẳng nghe lời họ.\nThế nên họ luôn tìm cách trả đũa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1148": "Ê, {#0}! Nghe nói cậu vừa\ncho đám Orc một trận ra trò!\nGiờ chỉ còn mục tiêu chính: Orc King!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1149": "QUÁ ĐỈNH! Cậu chờ dịp này lâu rồi\nđúng không? Giờ là lần đầu cậu\nđược đối đầu quái vật khổng lồ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1151": "Cậu sắp ra tận tiền tuyến rồi,\n{#0}! Tôi sẽ kể tất cả\nnhững gì chúng tôi biết về Orc King!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1152": "Nghe đây! Orc King là thủ lĩnh\ntộc bán nhân, to gấp bội Orc thường.\nCoi thường hắn là tiêu đời!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1153": "Hễ hắn quay cánh tay liên tục\nlà đang chuẩn bị chiêu Orcish Quake.\nTrúng chiêu ấy đau lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1154": "Nhưng lấy đà càng lâu thì\ncàng hở sườn. Canh đúng lúc\nlà cậu gây được sát thương lớn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1155": "Nghe đây! Orc King là thủ lĩnh\ntộc bán nhân, to gấp bội Orc thường.\nCoi thường hắn là tiêu đời!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1156": "Hễ hắn quay cánh tay liên tục\nlà đang chuẩn bị chiêu Orcish Quake.\nTrúng chiêu ấy đau lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1157": "Nhưng lấy đà càng lâu thì\ncàng hở sườn. Canh đúng lúc\nlà cậu gây được sát thương lớn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1158": "Ê! Nghe nói cậu hạ được Orc King rồi!\nKhá lắm, rất khá!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1159": "Đang thắng như chẻ tre thế này,\nđể tôi chỉ mục tiêu tiếp theo:\nquái vật ở sông Ifing!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1160": "Sông Ifing là nơi ta sắp bình định.\nChỗ đó đầy mấy con Domovoi\nnhỏ xíu, tròn vo, lông lá.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1161": "Đừng để vẻ ngoài đánh lừa!\nChúng phóng phép từ xa, bị đuổi\nthì chạy biến. Phiền chết đi được!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1162": "Nhớ hạ chúng trước nhé!\nKhông thì đang đánh con khác\nlại bị chúng bắn phép sau lưng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1163": "Ê! Đội An ninh chúng tôi\nkhông chỉ canh giữ biên giới,\nmà còn thu thập tin về quái vật.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1164": "Thế nên thường chúng tôi\nphát hiện quái mới đầu tiên.\nCòn ghi nhận vài loài với Học viện!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1165": "Thỉnh thoảng ghé qua nhé.\nTôi sẽ kể cho cậu về đám quái\ncó thể gặp ngoài kia!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1166": "Hừm, giờ ở đây đông vui thật.\nNgày đầu chỉ có tôi với Eadgils\nlo liệu hết mọi việc.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1167": "Rồi vài người gia nhập, thêm vài người.\nChớp mắt một cái, hai chúng tôi\nđã quản cả pháo đài với một đội quân!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1168": "Đừng để Domovoi dễ thương đánh lừa.\nChúng dùng phép tấn công từ xa,\nrồi chạy khi cậu áp sát.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1169": "Ê! Báo cáo nói khu sông Ifing\nchẳng có khổng lồ nào.\nCứ để Đội An ninh lo phần còn lại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1170": "Xin lỗi nhé, người hạ khổng lồ.\nĐâu phải lần nào cậu cũng\nđược chiếm hết công lao!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1171": "...Ê. Nghe này. Tôi cử vài người\nđi dò xét quái vật lớn quanh đây,\nmà giờ họ vẫn chưa về.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1172": "Đám ấy cũng vô tư như tôi,\nchắc nằm ngủ đâu đó thôi.\nVề đây thế nào cũng bị mắng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1173": "À... xin lỗi, tự nhiên tôi ủ rũ.\nĐừng lo! Người của tôi giỏi lắm.\nChắc chắn họ vẫn ổn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1174": "Nhưng tôi nghe khá nhiều người kể\ncó mấy con quái rất nguy hiểm\nẩn sâu dưới sông Ifing.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1175": "Quái ở đây vốn đã khó xử lý.\nNếu còn gặp loài hung dữ hơn,\nchúng ta sẽ khốn đốn mất.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1176": "Đám ấy cũng vô tư như tôi,\nchắc nằm ngủ đâu đó thôi.\nVề đây thế nào cũng bị mắng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1177": "Ê, {#0}! Cậu đến đúng lúc!\nTôi đang tìm cậu đây.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1178": "Hình như Brokkr muốn nhờ cậu\nviệc gì đó. Rảnh thì ghé\ntiệm rèn gặp anh ấy nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1179": "Nghe giọng anh ta có vẻ gấp,\nnên đừng để anh ta chờ lâu đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1180": "...Nghe này. Chúng tôi tìm thấy\nBùa Vảy của những người mất tích.\nNhưng... chỉ còn những lá bùa...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1181": "Tôi đã dặn họ luôn đeo theo người.\nGiờ chỉ tìm thấy bùa, nghĩa là...\nừm...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1182": "...Xin lỗi. Cho tôi ở một mình\nmột lát nhé? Nếu cần hỏi gì,\ncứ sang gặp Lif.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1183": "...Xin lỗi. Tôi cần ở một mình.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1184": "Này, {#0}... Cậu nghĩ\nnhững người đã ngã xuống hôm trước\nđến được Valhalla rồi chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1185": "Tôi sẽ gửi bùa và tư trang\nvề cho gia đình họ.\nCảm ơn cậu đã báo thù cho họ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1186": "Cậu biết không, Eadgils bắt\nmọi người đeo bùa để nhận ra\nđồng đội, đâu chỉ vì kỹ năng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1187": "Đau lòng là, ít ra ta còn thứ\nđể gửi về nhà cùng hung tin,\nnếu điều tồi tệ nhất xảy ra.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1188": "Vài người chẳng còn thân thích\nđể gửi bùa về. Nếu cậu giữ hộ,\nchắc họ sẽ vui lắm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::1189": "Eadgils bắt ai cũng đeo bùa,\nđể còn thứ gửi về nhà nếu họ\nkhông trở lại. Ông ấy tốt lắm."
  }
}
