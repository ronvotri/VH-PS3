    "menu.cpk::msg_field.en.pac::msg_room.bin::23": "Không thể vào phòng {#0}.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::24": "{#0} đã rời phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::25": "{#0} đã vào phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::26": "Không thể vào phòng này vì\nphiên bản game của bạn khác.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::27": "Khi khởi động Ragnarok Odyssey ACE\nvà kết nối PlayStation®3 với mạng,\ngame sẽ tự kiểm tra cập nhật.\nHãy làm theo hướng dẫn trên màn hình.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::28": "Đang kết nối...",
    "menu.cpk::msg_field.en.pac::msg_room.bin::29": "Mất kết nối.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::30": "Mọi người đã rời phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::32": "Không thể vào phòng này.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::33": "Do lỗi kết nối, trò chơi sẽ\nchuyển sang chế độ chơi đơn.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::34": "Đã nhấn nút nguồn hoặc nút PS.\nKết nối bị ngắt. Đang chuyển\nsang chế độ chơi đơn.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::35": "Chỉ một người bắt đầu nhiệm vụ.\nĐang trở về chế độ chơi đơn.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::36": "Tạo phòng với\nnhững thiết lập này?",
    "menu.cpk::msg_field.en.pac::msg_room.bin::37": "Đang tìm...",
    "menu.cpk::msg_field.en.pac::msg_room.bin::38": "Đang tạo...",
    "menu.cpk::msg_field.en.pac::msg_room.bin::39": "Không thể dùng tên này.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::40": "Không thể tạo phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::41": "Vui lòng nhập bốn ký tự.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::42": "Không tìm thấy phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::43": "Đã cấm {#0} vào phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::44": "Bạn đã bị cấm vào phòng.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::45": "Đang kết nối qua 3G.\nNên dùng Wi-Fi khi chơi nhiều người.\nHãy kết nối qua điểm phát Wi-Fi.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::46": "Sai mật khẩu.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::47": "{#0} đã rời phòng trước đó.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::48": "Không thể vào {#0}.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::49": "Đã đăng xuất nên không thể\ntiếp tục chơi mạng.\nĐang chuyển sang chơi đơn.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::50": "Máy chủ không phản hồi.\nKết nối đã ngắt.\nĐang chuyển sang chơi đơn.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::51": "Đang xử lý yêu cầu vào phòng...",
    "menu.cpk::msg_field.en.pac::msg_room.bin::52": "Đang ngắt kết nối...",
    "menu.cpk::msg_field.en.pac::msg_room.bin::53": "Đã đăng xuất. Không thể\ntiếp tục chơi nhiều người.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::54": "Đang kết nối máy chủ...",
    "menu.cpk::msg_field.en.pac::msg_room.bin::55": "Kết nối quá thời gian chờ.\nĐang chuyển sang chơi đơn.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::56": "Người chơi khác đã rời đi.\nĐang chuyển sang chơi đơn.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::58": "Trưởng nhóm đã hủy nhiệm vụ\nthay cả đội. Đang về pháo đài.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::59": "Không thể xuất phát làm nhiệm vụ.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::60": "Khu vực phát hành game của bạn\nkhác khu vực của phòng.\nKhông thể tham gia.",
    "menu.cpk::msg_field.en.pac::msg_room.bin::61": "Đang chọn nhiệm vụ...",
