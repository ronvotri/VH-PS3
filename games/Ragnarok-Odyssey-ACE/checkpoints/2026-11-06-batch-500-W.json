    "item.cpk::it_db.en.pac::it_db_text_card.rmsg::435": "Thẻ Fafnir.",
    "item.cpk::it_db.en.pac::it_db_text_card.rmsg::436": "Thẻ Fafnir.",
    "item.cpk::it_db.en.pac::it_db_text_card.rmsg::437": "Thẻ Fafnir.",
    "item.cpk::it_db.en.pac::it_db_text_card.rmsg::438": "Thẻ Fafnir.",
    "item.cpk::it_db.en.pac::it_db_text_card.rmsg::439": "Thẻ Fafnir.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3766": "Thay vào đó, nó liên quan tới\ncác vị thần Vanir cổ đại.\nCô ấy quả quyết như vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3767": "Tôi mừng vì nơi ấy không phải\nJotunheim thứ hai. Nhưng vẫn\nchưa thể yên tâm được đâu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3768": "Nhớ tôi từng thắc mắc vì sao\nngọn tháp bị phong kín bao năm\nmà quái vật vẫn đầy ắp chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3769": "Giờ thì ta đã biết tại sao.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3770": "Chúng được triệu hồi! Khắp\nvách tháp có những thiết bị\ngọi linh hồn quái vật tới.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3771": "Nói thẳng ra, cả ngọn tháp\nđang liên tục thi triển\nphép triệu hồi đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3772": "Thành ra cứ thứ gì cản đường,\ndù quái vật sống hay vong linh,\nta cũng phải vượt qua.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3773": "Nhưng điều đáng lo nhất là...\nNếu ngọn tháp cứ triệu hồi\nquái vật với tốc độ này...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3774": "Nó sẽ thành cả một nhà máy\nsản xuất quái vật khổng lồ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3775": "Chưa thấy quái vật bò ra ngoài,\nnhưng quanh đó đã xảy ra\nkhông ít chuyện đáng ngờ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3776": "Hơn nữa, ta còn có nghĩa vụ\nvới vương quốc. Không thể\ncứ mặc kệ nơi đó được.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3777": "Chỉ còn cách rà soát ngọn tháp\nthật kỹ, tìm cách vô hiệu hóa\ncác thiết bị kia thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3778": "Trước hết, phải tìm ra\ntầng đáy của ngọn tháp.\nLên đường nào!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3779": "Hừm. Vậy tháp ấy không phải\ncăn cứ lũ Khổng Lồ, mà là\ndi tích của thần Vanir cổ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3780": "Bảo sao từ đầu tôi cứ\nthấy có gì đó không ổn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3781": "Tôi mù tịt mấy chuyện thần thoại.\nMuốn biết thêm thì đi hỏi\nYukino ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3782": "Có vẻ ngọn tháp ấy từng được\nkích hoạt vài lần trong quá khứ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3783": "Khi đó, nó hiện ra như ảo ảnh\nở nhiều nơi trong vương quốc,\nchứ không rõ hình như bây giờ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3784": "Người ta gọi nó là\n\"Tháp Ảo Ảnh\", hoặc còn gọi\nlà \"Tháp Vô Tận\".",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3785": "Chỉ còn vài ghi chép, nhưng\nđều nói tháp có vô số tầng\nvà đầy rẫy quái vật.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3786": "Theo truyền thuyết, cửa tháp\ntự đóng mở, thậm chí cả tháp\ncòn biến mất theo thời gian.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3787": "Xét kết cấu của ngọn tháp,\ncác thiết bị triệu hồi và\nvô số quái vật bên trong...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3788": "Học viện tin rằng đây chính là\nTháp Ảo Ảnh trong truyền thuyết\nsa mạc năm xưa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3789": "Trước đây, người ta tin\nphép triệu hồi là ý chí Khổng Lồ\ndo Bảo Vật Vanir hiện hình.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3790": "Nhưng giả thuyết mới cho rằng\nBảo Vật Vanir vốn không\ncó quyền năng như thế.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3791": "Thay vào đó, chính các thiết bị\ntrong Tháp Yggdrasil đã tạo ra\nhiện tượng triệu hồi ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3792": "Dựa vào phạm vi linh hồn\nxuất hiện, có lẽ phép triệu hồi\nnhắm tới cả Vùng Đất Chia Cắt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3793": "Tuy nhiên, kể từ khi\nBảo Vật Vanir sụp đổ, các loài\nđược gọi tới có xu hướng rõ rệt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3794": "Học viện cho rằng hiệu lực\nthiết bị triệu hồi suy giảm\nrất mạnh bên ngoài ngọn tháp...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3795": "Nên chúng chỉ đáp lại\nlinh hồn từ cấp Đại Khổng Lồ\ntrở lên mà thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3796": "Dù vậy, quái vật cỡ lớn\nvẫn có thể bị gọi đến.\nCậu nhớ hết sức cẩn thận nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3797": "Chào {#0}.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3798": "Hôm nọ, tôi tình cờ nghe\nPavianne nhắc cậu đừng quên\nmỉm cười đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3799": "Với Kafra chúng tôi,\nniềm vui lớn nhất là được\nthấy khách hàng mỉm cười.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3800": "Lời Pavianne khiến tôi nhớ lại\nniềm háo hức và tự hào\nngày mới gia nhập Kafra.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3801": "Chưa kể đến con người thật\nmà cô ấy luôn giấu kín...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3802": "Từng lời nói, cử chỉ đều đậm\nchất Kafra. Tôi cảm động lắm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3803": "Ơ? \"Con người thật\"\ncủa Pavianne ấy à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3804": "Cô ấy có nhiều thói quen lạ,\nnhưng chỉ cần quan sát một chút\nlà nhận ra ngay thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3805": "Khó khăn thì nhờ người giúp,\nmuốn thấy nụ cười thì cứ nói.\nCô ấy thẳng thắn, cởi mở và...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3806": "...Ồ, mặt cô ấy đỏ bừng rồi.\nChắc tôi nên để dành màn\ntrêu chọc này cho lần sau.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3807": "Cô ấy dám nhờ cậy người khác,\nyêu những nụ cười và chân thành\nvới người mình quan tâm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3808": "Nếu muốn giữ mối quan hệ\nbền lâu với người tôi quý mến,\ntôi cũng sẽ làm như cô ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3809": "...Ôi chà, mặt cô ấy đỏ lựng,\nmắt rưng rưng nhìn tôi kìa.\nThôi, tha cho cô ấy... tạm vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3810": "{#0}, cậu đã chuẩn bị đủ\nbình thuốc chưa? Nhớ kiểm tra\ntrước khi làm nhiệm vụ nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3811": "H-Hả? Sao tự dưng cậu\nkhách sáo vậy?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3812": "Đ-Đừng hiểu lầm đấy nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3813": "Tôi đâu có nghĩ về cậu theo...\nkiểu ĐÓ như Leilah ám chỉ đâu!\nKhông có đâu nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3814": "Ý tôi là... nếu phải nói ra,\nthì tôi muốn cổ vũ cậu.\nMuốn hết lòng giúp cậu thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3815": "Và... ừm... thì...\ncậu biết đó..."
  }
}
