    "item.cpk::it_db.en.pac::it_db_text_bgm.rmsg::236": "Nhạc Picotto Knights\n\"Trùm Giữa Màn\"\nSáng tác: Shunsuke Tsuchiya (PROCYON\nSTUDIO)",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::221": "Domovoi rất thường gặp nhưng vẫn đầy\nbí ẩn, nhất là thủ lĩnh của chúng. Tôi\nmê loài này lắm! Cậu {#0}đi điều tra\nrồi cho tôi biết cách đánh bại\nchúng{#1} nhé?",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::222": "Ê, có việc cho cậu đây! Ra đó {#0}hạ\nđám Alp Leshy NGAY{#1}! Hàng khách cần\nđể tôi lo. Làm xong, cậu sẽ thành lính\nthuê cơ bắp như tôi!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::223": "Lại thấy thêm khổng lồ gần đỉnh núi\nHnitbjorg. Ở đó còn xuất hiện một loài\nquái chưa ai biết! {#0}Lên núi điều\ntra ngay{#1}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::224": "Đã thấy {#0}Grendel{#1} {#2}bên Sông\nIfing{#3}! Mau hạ hắn! Trời đất, ăn\nnguyên quả đạn pháo vào bụng mà hắn\nhồi phục ngay! Tên này lì đòn thật!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::225": "Nguy rồi! Tới Núi Lửa Của Thor! Lũ\nkhổng lồ {#0}đang tính làm núi lửa\nphun trào{#1}! Chúng còn dắt theo Sói\nLửa khổng lồ. Hãy {#2}chuẩn bị kỹ và\nphòng trạng thái Bỏng{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::226": "Đã tìm ra nguồn gốc bức tượng bay.\n{#0}Có ngôi đền lơ lửng trên núi\nHnitbjorg{#1}! Lũ khổng lồ muốn thứ gì\nđó ở đấy. {#2}Tới điều tra ngay{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::227": "Trước khi cử người quan sát vào đền,\nta phải dọn sạch hiểm nguy. {#0}Hãy\nquét sạch khu vực{#1}! Lên đó và\n{#2}hạ hết quái vật{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::228": "Bọn tôi đang mở đường lên núi\nHnitbjorg cho người quan sát, nhưng\nkhổng lồ chắn lối đông quá! {#0}Ai\nrảnh lên giúp một tay với{#1}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::229": "Chào cậu! Tới Phế Tích Glast Heim và\n{#0}săn Hjahanir giúp tôi{#1} nhé?\nNguyên liệu khách đặt tôi sẽ tự lo.\nCảm ơn nhiều!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::230": "Lod đây, mắt thần trên trời! Lũ Orc\nđang dựng làng trong đền! Cả {#0}Orc\nKing và Orc Hero{#1} cũng ở đó! Ai đó\n{#2}lên dẹp chúng đi{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::231": "Lod đây, mắt thần trên trời! Orc đi\nrồi, giờ {#0}Einherjar đông như\nkiến{#1}, giáp kêu loảng xoảng! Uống\nrượu cũng chẳng yên! Ai đó {#2}dẹp\nchúng hộ tui{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::232": "Chào cưng! Harald đây! Tôi nghĩ ra\ncách pha màu da khổng lồ rồi, nhưng\ncần {#0}mẫu da{#1}! Cậu {#2}cắt vài\nmảnh da khổng lồ{#3} cho tôi nhé?",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::233": "Chào, Linde đây! Nghe nói loài chim\nthật to khỏe rơi {#0}lông mềm tuyệt\nđẹp{#1}. Tôi mê lắm! Cậu {#2}nhặt vài\nchiếc cho tôi{#3} nhé?",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::234": "Người quan sát thấy đường vào\n{#0}Giếng Mimir{#1}. Hãy điều tra đi.\nTừ trên cao không nhìn thấy bên trong,\nnên cần cậu {#2}xuống tận nơi kiểm\ntra{#3}.",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::235": "Vào vị trí! {#0}Khổng lồ đang tấn\ncông{#1}! Thua trận này, cả vương quốc\nlâm nguy! {#2}Cầm chân tên to xác cho\ntới khi đại bác chính khai hỏa{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::236": "Ê, Poring ở Giếng Mimir đang quậy\ntưng! Tôi muốn vào đập cho đã mà phải\ngiữ tổng hành dinh. Cậu đi thay nhé.\n{#0}Đập đám Poring cho tôi{#1}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::237": "Lod đây, mắt thần trên trời! Trên kia\ngiờ đầy {#0}Leshy{#1}, lại còn\n{#2}Guardian{#3}! Phép chúng ầm như\nsấm, tui uống chẳng yên! {#4}Dẹp sạch\ngiùm tui{#5}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::238": "Đúng điều ta lo! {#0}Hai nữ khổng\nlồ{#1} đã xuất hiện, vũ khí to hơn cả\nngười! Chúng chẳng dễ xơi đâu. {#2}Xử\nlý cô ả ở Núi Lửa Của Thor{#3} trước!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::239": "Không còn thì giờ! {#0}Đến ngôi\nđền{#1} và {#2}đánh bại nữ khổng\nlồ{#3} ở đó. Cô ta rất khó nhằn! Nhớ\nđừng để cô ta phát hiện Lod!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::240": "*NẤC* Lên gần trời, tui suýt lên luôn\nthiên đàng! Mà này, {#0}khổng lồ đang\nkéo tới phế tích{#1}. Để chúng đóng\nquân thì phiền to. {#2}Dẹp chúng đi!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::241": "Ê, có việc đây! Ra ngoài {#0}hạ vài\ncon Spore NGAY{#1}! Hàng khách cần tôi\nsẽ lo. Xong việc là cậu cũng thành\nlính thuê cơ bắp!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::242": "Đến lúc giúp người quan sát! Ta sẽ\n{#0}tổng vệ sinh Vùng Đất Chia\nCắt{#1}. Hãy {#2}diệt thật nhiều quái\nvật{#3} để Lod dễ theo dõi!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::243": "Đến lúc giúp người quan sát! Ta sẽ\n{#0}tổng vệ sinh Vùng Đất Chia\nCắt{#1}. Hãy {#2}diệt thật nhiều quái\nvật{#3} để Lod dễ theo dõi!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::244": "Đến lúc giúp người quan sát! Ta sẽ\n{#0}tổng vệ sinh Vùng Đất Chia\nCắt{#1}. Hãy {#2}diệt thật nhiều quái\nvật{#3} để Lod dễ theo dõi!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::245": "Fenia và Menia đã {#0}tấn công Giếng\nMimir{#1}! Hai cô ả hợp sức mạnh ít\nnhất ngang Hrungnir! Đừng coi thường\nchúng!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::246": "Ê, đang tuần tra núi Hnitbjorg thì một\n{#0}đàn Hell Hound cực đông{#1} xuất\nhiện, gây rối quá chừng! {#2}Ai đó lên\ngiúp bọn tôi hạ chúng{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::247": "Nguy rồi! Đang tuần tra Núi Lửa Của\nThor, bọn tôi đụng {#0}một đàn Magma\nDeath Rock khổng lồ{#1}! Đông quá chịu\nkhông nổi! {#2}Ai rảnh tới tiếp\nviện{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::248": "Chào cậu! Tới Đỉnh Tháp Đảo Ngược và\n{#0}săn Orc Hero giúp tôi{#1} nhé? Đồ\nkhách cần tôi sẽ tự lo. Cảm ơn!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::249": "Để chịu được giá rét Jotunheim, ta cần\nlàm kem chống lạnh. Mà phải có {#0}Mỡ\nRồng{#1}! Hãy tới Phế Tích Glast Heim\n{#2}lấy từ Fafnir{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::250": "Đến lúc dùng trí tuệ cô ấy rồi! Tới\nGiếng Mimir và {#0}lấy những Thánh\nKhí{#1}. Cẩn thận, nghe nói có Đại\nKhổng Lồ quen mặt quanh đó!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::251": "Đùa à?! Tuần tra Sông Ifing mà gặp\n{#0}cả hai giống Hraesvelgr{#1}! 3\nngười bọn tôi xử không xuể. {#2}Ai đến\ngiúp với{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::252": "Harald đây! Tôi NHẤT ĐỊNH phải có sắc\nda trắng ấy! Cậu {#0}cắt vài mẫu da\nLeshy cho tôi{#1} nhé? À, {#2}coi\nchừng con thằn lằn khổng lồ!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::253": "Linde đây! Nghe nói quái trắng rơi\n{#0}xương đẹp mê ly{#1}. Cậu kiếm giúp\nnhé? Nhưng cẩn thận, bọn màu trắng\nthường {#2}đi cùng lũ anh em màu\nxanh{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::254": "Trời đất, {#0}đàn sói to xác{#1} đã\nkéo tới Giếng Mimir! Không thể để\nchúng cản trận đánh Jotunheim. {#2}Đến\nđó dẹp chúng ngay{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::255": "Bị tấn công rồi! {#0}Cầm chân địch tới\nkhi đại bác chính khai hỏa{#1}. Nhưng\n{#2}đừng để chúng áp sát húc sập\ncổng{#3}! Không thì tiêu cả lũ!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::256": "Đến lúc {#0}đánh Utgardar{#1}! Lũ\nkhổng lồ có thể chưa biết ta đến,\nnhưng chúng đông lắm! {#2}Chuẩn bị cho\ntrận đánh kéo dài{#3} trước biển địch!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::257": "Ê, khổng lồ hành quân rồi! Chúng tràn\nkhắp Đồng Bằng Idavoll, đang tiến về\npháo đài! Ai rảnh, {#0}ra đó giúp tiêu\ndiệt chúng{#1}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::258": "*NẤC* Khổng lồ đông nghẹt! Núi\nHnitbjorg đầy Khổng Lồ Băng kéo về\nđền! Ai rảnh {#0}lên đó giúp tui\nvới{#1}! Dzô!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::259": "Ôi không! Khổng Lồ Lửa xuất hiện vô số\nở Núi Lửa Của Thor. Chúng định làm núi\nlửa phun lần nữa! Ai rảnh {#0}tới tiếp\nviện với{#1}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::260": "Ở vùng ấy rất có thể gặp {#0}hai thủ\nlĩnh Khổng Lồ Đồi Fenia và Menia{#1}.\nLần này chúng đánh thật đấy! {#2}Chuẩn\nbị cho trận chiến lớn{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::261": "Ở vùng ấy rất có thể gặp {#0}thủ lĩnh\nKhổng Lồ Lửa Surt{#1}. Tên này đang\nnghiêm túc đấy! {#2}Sẵn sàng cho trận\nquyết chiến{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::262": "Ở vùng ấy rất có thể gặp {#0}thủ lĩnh\nKhổng Lồ Băng Hrungnir{#1}. Hắn chẳng\nđùa đâu! {#2}Chuẩn bị cho trận đại\nchiến{#3}!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::263": "{#0}Đích thân Vua Khổng Lồ Utgarda\nLoki{#1} đã lộ diện! Trận cuối đây\nrồi! Bọn ta giữ pháo đài, cậu {#2}dốc\ntoàn lực chiến đấu{#3}! Bắt đầu Chiến\ndịch Ragnarok! XUẤT QUÂN!",
