    "menu.cpk::msg_field.en.pac::msg_quest.bin::1466": "Khúc Cuồng Ca – Kiếm Tinh Xảo",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1467": "Con",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1468": "Dạo này sao rồi?\nCậu đi {#0}săn vài con\nDomovoi Sa Mạc{#1} giúp tôi nhé?\nSa mạc được xem là {#2}kho vũ khí{#3},\nbiết đâu {#4}cậu kiếm được vũ khí mới{#5}.\nNghe hấp dẫn chứ?",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1469": "Sa Mạc Sograt",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1470": "Desert Domovoi",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1472": "Khúc Cuồng Ca – Rồng Hung Hãn",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1473": "Ottar",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1474": "Ê, có việc mới đây!!\nMau lên đường săn Lindwurm!\nMuốn trở thành lính đánh thuê\ntầm cỡ thì đừng né trận này!\nChơi lớn một phen đi!!",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1475": "Niflheim",
    "menu.cpk::msg_field.en.pac::msg_quest.bin::1476": "Lindwurm"
