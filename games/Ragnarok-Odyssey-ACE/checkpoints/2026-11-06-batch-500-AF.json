    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::129": "Ống Tẩu Cháy",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::130": "Mặt Nạ Lửa",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::131": "Bồ Hóng Mịn",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::132": "Găng Tay Kafra",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::133": "Ủng Kafra",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::134": "Tạp Dề Kafra",
