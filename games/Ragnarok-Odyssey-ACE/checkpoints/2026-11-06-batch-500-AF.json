  "notes": "80 NPC, 160 material names, 260 crafting-order names (base families); original text and metadata preserved; stock validator run.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4401": "Thuở xưa, Tháp Ảo Ảnh bỗng xuất hiện\ntrong vương quốc. Nay ta nghĩ nó là\ncái bóng của Tháp Yggdrasil.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4402": "Một đội hiệp sĩ được cử tới đó.\nHọ tìm thấy Galdrabok và dùng nó\ncùng thiết bị triệu hồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4403": "Theo hồ sơ, họ đã tới Niflheim\nthành công.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4404": "Nhưng kẻ duy nhất trở về lại là\nchim bồ câu đưa tin họ sắp\nthi triển phép thuật đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4405": "Hử? Ta có chắc nên kể cậu nghe\nchuyện tuyệt mật này không ấy à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4406": "Có chứ. Ta đã được phép báo cho\nvài thành viên trong đoàn\ncần biết chuyện này.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4407": "Vả lại, không thể cử người đi\nmà chẳng phổ biến tình hình\ncho họ trước được.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4408": "Đội ta nhanh và dày dạn hơn,\nnên đi thay các hiệp sĩ\nmới là hợp lý.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4409": "Hừm, trông cậu cũng sắp tự ý\nchạy tới đó, dù ta có cho phép\nhay không, nhỉ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4410": "Ít nhất trông cậu là vậy.\nTa đoán sai sao?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4411": "Tóm lại! Galdrabok đã an toàn,\nnhưng Niflheim vẫn hoàn toàn\nlà vùng đất bí ẩn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4412": "Nhớ trang bị kỹ trước khi đi.\nHỏi Yukino và phu nhân xem họ\nđọc được gì từ ghi chép nữa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4413": "Đến chốn chưa ai biết, manh mối\nnào cũng quý. Biết đâu một câu\nlại cứu mạng cậu đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4414": "Galdrabok đã an toàn, nhưng\nNiflheim vẫn là vùng đất\nhoàn toàn bí ẩn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4415": "Nhớ trang bị thật kỹ\ntrước khi lên đường.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4416": "Chào {#0}. Chúng tôi đã\ngiải mã thêm ghi chép của\nhiệp sĩ Glast Heim rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4417": "Theo đó, thành phố người chết\nở Niflheim bị bao phủ bởi sương\nmù dày đặc, làm loạn giác quan.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4418": "Muốn xuyên sương để vào thành,\ncậu phải tìm ra và phá hủy\nnguồn phát sinh màn sương ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4419": "Đáng tiếc, chúng tôi chưa biết\nnguồn sương mù đó là thứ gì.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4420": "Tôi đang đọc các thần thoại cổ\nđể tìm thêm manh mối.\nCó tin gì tôi sẽ báo cậu ngay.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4421": "Theo ghi chép, thành phố người\nchết ở Niflheim chìm trong sương\nmù khiến giác quan rối loạn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4422": "Muốn vượt sương để vào thành,\ncậu phải tìm và phá hủy\nnguồn phát sinh màn sương.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4423": "Tiếc là thông tin về Niflheim\nchỉ còn trong thần thoại\nvà truyền thuyết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4424": "Lời kể tận mắt đáng tin như\nghi chép của hiệp sĩ Glast Heim\nhiếm vô cùng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4425": "Thật ra, tôi nghĩ đây là nguồn\nđầu tiên chúng ta có thể\nxác minh là đúng sự thật.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4426": "Vô tình thôi mà cậu tìm ra\ntư liệu quý đến mức giới học giả\nxem như quốc bảo đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4427": "Tớ đã nhận lệnh rồi! Trời ơi,\ncậu sắp thám hiểm thành phố\nngười chết à? Lần đầu tớ thấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4428": "Chẳng ai biết có loại quái vật\nnào đang ẩn náu ở đó cả.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4429": "Mina bảo chưa chắc vào rồi\ncòn ra được đâu. Nên cậu phải\ncẩn thận THẬT LÀ cẩn thận!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4430": "Hả? Nếu bị lạc thì phải\nlàm sao ấy à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4431": "Ừm... câu hỏi hay đấy.\n...À! Tớ có cách này!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4432": "{#0}*CƯỜI TƯƠI HẾT CỠ*",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4433": "Nếu có lạc đường, cậu cứ\nnghĩ đến tớ nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4434": "Lấy nụ cười tớ làm cột mốc,\nthế nào cậu cũng tìm được\nđường về cho xem!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4435": "Á! Blossom! Leilah! Hai cậu\nđừng đứng đó cười nhếch mép nữa!\nTrời ơi, đủ rồi mà!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4436": "{#0}*CƯỜI TƯƠI HẾT CỠ*",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4437": "Nếu lạc, cứ nghĩ đến nụ cười\ntớ như một cột mốc, rồi cậu\nsẽ tìm được đường về ngay!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4438": "Chào mừng! Hôm nay tôi có\ntin cực vui cho cậu đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4439": "Nhờ nghiên cứu đống nguyên liệu\nmới, tôi đã làm được loạt mũ\nmới để bán! Tuyệt chứ hả?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4440": "Chủ đề mới là \"Bằng Chứng Có Tội\"!\nDành cho ai muốn theo phe bóng tối.\nBên đó có bánh quy nữa cơ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4441": "Mừng cậu về, {#0}!\nTôi vui vì cậu trở về\nan toàn đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4442": "Cử ai đó sang hẳn một thế giới\nkhác khiến tôi lo đến\nđứng ngồi không yên...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4443": "Nhưng cậu đã về nguyên vẹn!\nGiỏi lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4444": "Tôi biết hơi đường đột,\nnhưng cậu báo cáo về\nNiflheim được chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4445": "Hử? Cậu cứ đi vòng vòng,\nđến nỗi chẳng hình dung được\nbố cục thành phố sao?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4446": "À, chắc cậu đã vướng vào\nmàn sương gây rối loạn\ngiác quan ấy rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4447": "May là cậu về được. Nhưng muốn\ntiến sâu hơn, ta phải tìm\nra nguồn gốc màn sương.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4448": "Tôi linh cảm chẳng lành...\nHả, cậu cũng vậy sao?\nMừng là ta cùng nghĩ thế...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4449": "Những chuyện như vậy thường\ndẫn đến một con quái vật\nđáng sợ ngoài sức tưởng tượng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4450": "Mà lần này nó còn ở cõi chết.\nThật tình, tôi chẳng muốn\nnghĩ tới nữa...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4451": "Tiếc là mục tiêu kế tiếp\nhẳn sẽ là xóa tan\nmàn sương mù ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4452": "Trước khi có lệnh chính thức,\ntôi muốn cậu tiếp tục\nthăm dò nơi đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4453": "Nếu không xử lý sương mù\ngây loạn giác quan, ta khó\ncó thể tiến thêm bước nào.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4454": "Chắc nhiệm vụ tới là xóa sương.\nTrong lúc chờ lệnh, cậu cứ\ntiếp tục thăm dò nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4455": "{#0}! Cậu đã trở về\nnguyên vẹn rồi đấy à!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4456": "Ta thừa nhận đã phân vân\nkhi cử người của mình sang\nhẳn một thế giới khác...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4457": "Nhưng cậu về bình an rồi.\nLàm tốt lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4458": "Rồi, giờ kể ta nghe\ntình hình bên đó nào.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4459": "Hử? Cậu cứ đi vòng vòng\nmà chẳng nắm nổi\nbố cục thành phố sao?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4460": "...À, chắc cậu đã lạc vào\nmàn sương làm rối giác quan\nmà họ từng nhắc tới.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4461": "Cậu đã thoát ra, nhưng muốn\nđi sâu hơn thì ta phải\nxử lý màn sương đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4462": "Ta có linh cảm chẳng lành...\nHử, cậu cũng thấy thế à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4463": "Ha ha! Vậy là ta cùng nghĩ.\nNhưng mấy vụ thế này kiểu gì\ncũng có quái vật phiền phức.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4464": "Mà lại là quái vật từ cõi chết!\nTrời đất ơi, ta chẳng muốn\nnghĩ đến nó nữa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4465": "Thôi thì nhiệm vụ tới\nchắc chắn là xóa\nmàn sương ấy rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4466": "Trước khi có lệnh chính thức,\ncậu cứ tiếp tục thám hiểm đi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4467": "Phải xử lý màn sương làm loạn\ngiác quan ấy, nếu muốn\ntiến sâu hơn vào Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4468": "Trước khi có lệnh chính thức,\ncậu cứ tiếp tục thăm dò nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4469": "Cuối cùng chúng tôi đã tìm ra\nnguồn gốc màn sương rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4470": "Từ những đặc điểm màn sương\ncậu ghi trong báo cáo...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4471": "chúng tôi tìm thấy một\ntruyền thuyết nói về\nmàn sương y hệt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4472": "Đáng tiếc, nguyên nhân còn\nkinh khủng hơn xa\nmọi điều chúng tôi nghĩ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4473": "...Cậu sẵn sàng chưa?\nNghe cho kỹ nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4474": "Sương chính là hơi thở của\nHắc Long \"Nidhoggr\". Nó dùng\nmàn sương bẫy người sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4475": "Nó phủ sương khắp thành, dụ\nngười sống vào lãnh địa rồi\ncướp đi linh hồn họ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4476": "Phải. Vậy nên rất có thể\nnó đã biết cậu từng\nđặt chân đến Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4477": "Theo truyền thuyết, Nidhoggr\ntàn ác và xảo quyệt đến mức\nLindwurm trông như thú cưng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4478": "Hắc Long là quái vật giữa\nmuôn quái vật. Nó có từ thuở\nkhai thiên, sống qua cả Ragnarok!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4479": "Lạy thần Frigg! Lần này\nchúng ta đã gặp thứ quái vật\nthật không thể tin nổi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4480": "Nhưng muốn tìm hiểu Niflheim\nvà mối liên hệ với khổng lồ,\nta buộc phải vượt qua Nidhoggr.",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::100": "Chất Nhầy Dính",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::101": "Táo Chưa Chín",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::102": "Garlet",
