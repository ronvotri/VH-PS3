    "item.cpk::it_db.en.pac::it_db_name_voice.rmsg::56": "{#0}Giọng Giáo sĩ nữ: Hannah",
    "item.cpk::it_db.en.pac::it_db_name_voice.rmsg::57": "{#0}Giọng Thợ săn nữ: Rasha",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::0": "Khởi động giọng chiến đấu nào!\nChọn “Chàng Trai Quyến Rũ” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::1": "Khởi động giọng chiến đấu nào!\nChọn “Chàng Trai Lạnh Lùng” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::2": "Khởi động giọng chiến đấu nào!\nChọn “Chàng Trai Bảnh Bao” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::3": "Khởi động giọng chiến đấu nào!\nChọn “Cơn Giận Bốc Lửa” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::4": "Khởi động giọng chiến đấu nào!\nChọn “Anh Chàng Cá Tính” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::5": "Khởi động giọng chiến đấu nào!\nChọn “Thiếu Niên” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::6": "Khởi động giọng chiến đấu nào!\nChọn “Nhóc Tì Vui Vẻ” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::7": "Khởi động giọng chiến đấu nào!\nChọn “Chàng Trai Chững Chạc” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::8": "Khởi động giọng chiến đấu nào!\nChọn “Ông Lão Nghiêm Nghị” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::9": "Khởi động giọng chiến đấu nào!\nChọn “Gã Lì Đòn” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::10": "Khởi động giọng chiến đấu nào!\nChọn “Người Đàn Ông Dễ Mến” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::11": "Khởi động giọng chiến đấu nào!\nChọn “Lộng Lẫy!” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::12": "Khởi động giọng chiến đấu nào!\nChọn “Kẻ Tự Luyến” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::13": "Khởi động giọng chiến đấu nào!\nChọn “Lão Già Cộc Cằn” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::14": "Khởi động giọng chiến đấu nào!\nChọn “Điên Hết Cỡ!” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::15": "Khởi động giọng chiến đấu nào!\nChọn “Anh Chàng Hiền Lành” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::16": "Khởi động giọng chiến đấu nào!\nChọn “Nhiệt Huyết Sục Sôi” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::17": "Khởi động giọng chiến đấu nào!\nChọn “Chàng Trai Hóm Hỉnh” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::18": "Khởi động giọng chiến đấu nào!\nChọn “Lạnh Lùng Cay Đắng” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::19": "Khởi động giọng chiến đấu nào!\nChọn “Bá Chủ Chinh Phục” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::20": "Khởi động giọng chiến đấu nào!\nChọn “Justin” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::21": "Khởi động giọng chiến đấu nào!\nChọn “Đầu Gấu Sân Chơi” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::22": "Khởi động giọng chiến đấu nào!\nChọn “Binh Nhí” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::23": "Chỉ dùng cho Kiếm sĩ nam\n(Erik).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::24": "Chỉ dùng cho Chiến binh búa nam\n(Lars).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::25": "Chỉ dùng cho Sát thủ nam\n(Theodore).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::26": "Chỉ dùng cho Pháp sư nam\n(Brett).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::27": "Chỉ dùng cho Giáo sĩ nam\n(Jim).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::28": "Chỉ dùng cho Thợ săn nam\n(Karl).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::29": "Khởi động giọng chiến đấu nào!\nChọn “Quý Cô Kiêu Sa” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::30": "Khởi động giọng chiến đấu nào!\nChọn “Người Phụ Nữ Xinh Đẹp” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::31": "Khởi động giọng chiến đấu nào!\nChọn “Quý Cô Đáng Yêu” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::32": "Khởi động giọng chiến đấu nào!\nChọn “Cô Nàng Tốt Bụng” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::33": "Khởi động giọng chiến đấu nào!\nChọn “Quý Cô Thanh Lịch” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::34": "Khởi động giọng chiến đấu nào!\nChọn “Em Gái Nhỏ” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::35": "Khởi động giọng chiến đấu nào!\nChọn “Cô Nàng Vui Vẻ” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::36": "Khởi động giọng chiến đấu nào!\nChọn “Cô Nàng Cáu Kỉnh” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::37": "Khởi động giọng chiến đấu nào!\nChọn “Thiếu Nữ Dịu Dàng” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::38": "Khởi động giọng chiến đấu nào!\nChọn “Nữ Chiến Binh Amazon” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::39": "Khởi động giọng chiến đấu nào!\nChọn “Nữ Hoàng Quyền Quý” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::40": "Khởi động giọng chiến đấu nào!\nChọn “Thiếu Nữ” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::41": "Khởi động giọng chiến đấu nào!\nChọn “Cô Nàng Nghiêm Nghị” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::42": "Khởi động giọng chiến đấu nào!\nChọn “Thiếu Nữ Nhút Nhát” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::43": "Khởi động giọng chiến đấu nào!\nChọn “Điên Hết Cỡ!” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::44": "Khởi động giọng chiến đấu nào!\nChọn “Quý Cô Thông Thái” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::45": "Khởi động giọng chiến đấu nào!\nChọn “Chị Gái Đảm Đang” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::46": "Khởi động giọng chiến đấu nào!\nChọn “Tiểu Thư Hoang Dã” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::47": "Khởi động giọng chiến đấu nào!\nChọn “Thiếu Nữ Trầm Lặng” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::48": "Khởi động giọng chiến đấu nào!\nChọn “Nữ Huấn Luyện Viên” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::49": "Khởi động giọng chiến đấu nào!\nChọn “Feena” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::50": "Khởi động giọng chiến đấu nào!\nChọn “Cô Nàng Tràn Năng Lượng” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::51": "Khởi động giọng chiến đấu nào!\nChọn “Cô Nàng Kiên Định” nhé!\nĐến giờ đổi phong cách rồi!",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::52": "Chỉ dùng cho Kiếm sĩ nữ\n(Adrienne).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::53": "Chỉ dùng cho Chiến binh búa nữ\n(Immaculee).",
    "item.cpk::it_db.en.pac::it_db_text_voice.rmsg::54": "Chỉ dùng cho Sát thủ nữ\n(Carina).",
