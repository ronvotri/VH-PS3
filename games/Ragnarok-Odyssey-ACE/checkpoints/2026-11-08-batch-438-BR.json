    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::0": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Odin nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::1": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Baldr nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::2": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Hoor nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::3": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Tyr nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::4": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Magni nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::5": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Haenir nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::6": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Bragi nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::7": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Heimdallr nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::8": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Thor nhé! Tút tát thôi!",
    "item.cpk::it_db.en.pac::it_db_text_hair.rmsg::9": "Muốn thắng phải ăn diện! Thử\nkiểu tóc Ullr nhé! Tút tát thôi!",
