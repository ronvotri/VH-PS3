  "source": "RagnarokACE-BanGiaoDich-2026-11-04.zip",
  "total": 495,
  "notes": "Đợt U: 95 lời thoại NPC 3611–3705 (Tháp Yggdrasil, Lif/Thrasir, Brokkr, nhiệm vụ chặn viện binh), 300 tên thẻ 0–299, 100 mô tả thẻ 0–99. Tên quái giữ nguyên theo glossary; 30 mẫu mô tả dịch trực tiếp theo nội dung gốc và độ hiếm; giữ [Card No.xxx-C/U/R], số liệu, token {#0}. Chạy QA với danh sách pending trong ZIP; all_records.json bị lỗi zip local-header nên chưa đối chiếu được full catalog. Chưa thử patch trên RPCS3/PS3.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3611": "Trước đây, Yukino có nhờ tôi\nhỗ trợ nghiên cứu về Vua Khổng Lồ\nvà Yggdrasil.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3612": "Tôi có quen biết ở Học viện Hoàng gia,\nnên đã nhận lời giúp cô ấy.\nChúng tôi hợp tác khá nhiều đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3613": "Có lẽ tôi đã nhìn lầm, nhưng trước giờ\ntôi cứ nghĩ cô ấy là người\nhiếm khi để lộ cảm xúc.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3614": "Vậy mà lúc bàn chuyện nghiên cứu,\ncô ấy cứ mỉm cười dịu dàng suốt.\nTôi thực sự ngạc nhiên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3615": "Chẳng biết cô ấy vừa gặp\nchuyện gì vui đến thế nhỉ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3616": "À, mừng cậu trở về.\nViệc khám phá ngọn tháp thế nào rồi?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3617": "Hửm? Xuống sâu đến đâu\ncậu vẫn chưa tìm thấy tầng đáy ư?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3618": "Thậm chí cậu nghĩ mình chưa đi\nđược nửa đường? Xin nữ thần Frigg\nrủ lòng thương!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3619": "Nhìn cánh cổng vào khổng lồ,\ntôi đã đoán ngọn tháp này rất lớn...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3620": "Nhưng nếu các tầng dưới đã như vậy,\ntoàn bộ ngọn tháp hẳn phải\nlớn đến mức không tưởng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3621": "Đó cũng chưa phải điều\nduy nhất khiến ta lo lắng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3622": "Đúng như dự đoán, từ khi cánh cổng\nxuất hiện, lũ Khổng Lồ ẩn náu ở\nVùng Đất Chia Cắt hoạt động mạnh hơn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3623": "*THỞ DÀI*... Ôi, rối ren thật đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3624": "Nhưng việc cần làm vẫn phải làm.\nGiờ ta phải cố tìm cho ra\ntầng đáy của ngọn tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3625": "Càng nghe những thông tin\nvề Tháp Yggdrasil...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3626": "tôi càng thấy nơi ấy không thuộc\nquyền kiểm soát của Khổng Lồ.\nEadgils cũng nghĩ như tôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3627": "Chúng tôi đã nhờ Mina gửi lời\nđến Học viện, yêu cầu tra cứu\nmọi tư liệu họ có về ngọn tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3628": "Mina còn nói chuyện này có thể\nliên quan đến đề tài khác\ncô ấy đang nghiên cứu cùng Yukino.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3629": "Yukino hiện đang làm nhiệm vụ.\nTôi tin khi trở về, cô ấy\nsẽ có thêm thông tin cho ta.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3630": "Xem ra tôi và Thrasir\ncũng đến lúc lên đường làm nhiệm vụ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3631": "Hả? Bọn tôi cũng đi khám phá\nTháp Yggdrasil à? Không đâu,\nphải đi diệt ổ Khổng Lồ mới tìm ra.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3632": "Mani, Sol và cả Yukino đều đã\nra ngoài làm nhiệm vụ, nên ổ đó\nchỉ bé xíu thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3633": "Nhưng nghe nói từ khi cổng xuất hiện,\nlũ Khổng Lồ hoạt động dữ hơn.\nBọn tôi vẫn phải cẩn thận.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3634": "Lif, tớ đã bảo dù thế nào\ncũng sẽ bảo vệ cậu mà.\nCậu không cần quá lo đâu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3635": "A ha ha! Cảm ơn cậu, Thrasir.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3636": "Nhưng tớ thật sự không muốn\nthấy cậu bị thương,\nnhất là vì tớ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3637": "Hay là thôi đừng nói chuyện\nai sẽ liều mạng bảo vệ ai\nnữa, được không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3638": "Cứ hứa sẽ trông chừng nhau nhé.\nVậy cả hai sẽ sống sót\nvà mãi được ở bên nhau.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3639": "C-cái gì?! Hả?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3640": "À-ờ... ừ, nghe hay đấy.\nCảm ơn cậu, Lif.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3641": "Đi làm nhiệm vụ à?\nCẩn thận và chúc may mắn nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3642": "...Khoan, {#0}! Đừng nói cậu\nVẪN chưa đến gặp Brokkr\nđể nhận vũ khí mới nhé?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3643": "Cậu vẫn chưa đi thì chắc phải\ncó lý do. Thôi được,\ntôi không cằn nhằn nữa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3644": "Nhưng ông ấy hỏi thăm cậu suốt.\nChắc chắn là vũ khí mới rất hữu ích.\nCậu nên đến gặp ông ấy sớm đi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3645": "Đi làm nhiệm vụ à?\nCẩn thận và chúc may mắn nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3646": "À, cậu về rồi, {#0}.\nKhám phá ngọn tháp thế nào?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3647": "...Cái gì? Xuống sâu đến mấy\nvẫn chưa chạm tới đáy sao?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3648": "Thậm chí chưa được nửa đường?\nTrời đất ơi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3649": "Nhìn cái cổng tổ chảng ấy,\nta đã biết ngọn tháp phải rất lớn...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3650": "Nhưng nếu tầng dưới đúng như\ncậu kể, nó phải khổng lồ\nđến mức không tưởng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3651": "Đám Khổng Lồ ở Vùng Đất Chia Cắt\ncũng đang quậy phá dữ hơn\nở khắp nơi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3652": "Cứ như chúng cũng đang phản ứng\nvới cánh cổng ấy, y như ta.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3653": "Chậc! Hết chuyện này\nlại đến chuyện khác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3654": "Thôi được. Giờ việc quan trọng\nlà phải tìm ra đáy ngọn tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3655": "Càng nghe thêm về ngọn tháp đó...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3656": "ta càng thấy nơi ấy\nchẳng phải địa bàn của lũ Khổng Lồ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3657": "Ta đã nhờ quý cô gửi yêu cầu\nđến Học viện, xem trong kho lưu trữ\ncó tài liệu nào về nó không.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3658": "Thế mà cô ấy lại bảo chuyện này\ncó thể liên quan đến đề tài\ncô ấy đang nghiên cứu cùng Yukino.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3659": "...Thôi kệ. Yukino đang làm nhiệm vụ,\nđợi cô ấy về ắt sẽ có tin mới.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3660": "Yukino và tôi đã âm thầm\nnghiên cứu về Yggdrasil.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3661": "Nếu giả thuyết hiện tại của chúng tôi\nlà đúng...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3662": "thì Tháp Yggdrasil có lẽ\nlà phát hiện của cả thế kỷ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3663": "Tôi tin thông tin Yukino mang về\nsẽ đủ để xua tan những nghi ngờ\ncủa Eadgils nữa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3664": "Ồ, cậu chuẩn bị làm nhiệm vụ à?\nChúc may mắn và cẩn thậ--",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3665": "...Khoan, {#0}! Cậu VẪN\nchưa đến gặp Brokkr\nnhận vũ khí mới sao?! Tại sao?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3666": "Cậu vẫn chưa đi thì chắc là\ncó lý do. Thôi, tôi không\nlàm phiền cậu chuyện ấy nữa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3667": "Nhưng ông ấy nhắc cậu mãi.\nVũ khí ấy chắc chắn rất hữu ích.\nCậu nên đến đó sớm đi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3668": "Ồ, cậu chuẩn bị làm nhiệm vụ à?\nChúc may mắn, nhớ cẩn thận nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3669": "À, {#0}. Chắc cậu đã kiếm được\nkhá nhiều vũ khí Halomonas rồi nhỉ...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3670": "Nhưng nếu có loại biến hình,\nnhớ cẩn thận cách nuôi dưỡng nó,\nhiểu chưa hả?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3671": "Tùy cách cậu sử dụng,\nnó có thể biến thành\nnhững hình dạng khác hẳn đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3672": "Làm đúng cách, cậu có thể\nsở hữu một vũ khí\nmạnh kinh người.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3673": "...Mà cứ làm theo ý mình,\nxem nó thành ra thứ gì\ncũng thú vị phết nhỉ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3674": "Chào mừng! Hôm nay tôi có\ntin cực hay cho cậu đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3675": "Không ngờ làm việc với\nnguyên liệu mới lại hiệu quả đến thế!\nTôi có mũ mới để bán rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3676": "Ý tưởng thiết kế lần này là\n\"Tôi Muốn Hòa Làm Một Với Gió!\"\nMong cậu ghé xem bộ sưu tập nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3677": "Này, này, {#0}!\nĐịnh ra ngoài à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3678": "Dạo này ở đây bận rộn ghê.\nĐội Bình Định điều động\ngần như tất cả mọi người đi hết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3679": "Pháo đài vắng hẳn. Nhưng yên tâm!\nĐám pháo thủ chính thức bọn tôi\nsẽ giữ nơi này an toàn cho cậu!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3680": "Xin lỗi vì phải ngắt việc\nkhám phá ngọn tháp,\nnhưng ta gặp chút rắc rối rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3681": "Thrasir và Lif đã lên đường\ndiệt một ổ Khổng Lồ nhỏ\nmà ta mới phát hiện...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3682": "Nhưng Lod vừa gửi tin khẩn\ntừ Ngôi Đền Trên Không.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3683": "Có một toán Khổng Lồ khác\nđang tiến thẳng đến chỗ\nThrasir và Lif!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3684": "Xem ra bọn chúng đã phát hiện\nkế hoạch của ta bên đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3685": "Nếu toán viện binh ấy đến kịp,\ndù giỏi đến đâu, hai người họ\ncũng sẽ lâm nguy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3686": "Ta muốn cậu lập tức đến\nkhu vực được chỉ định chặn viện binh.\nNếu có thể, hãy diệt sạch chúng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3687": "Ta đã ban lệnh chính thức.\nChuẩn bị xong là có thể lên đường.\nNhanh lên!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3688": "Sao cơ? Norn đang ở\ntrong Tháp Yggdrasil ư?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3689": "Ôi, nữ thần Frigg ơi.\nĐứa bé ấy lại bày trò gì nữa đây?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3690": "{#0} à? Phiền cậu báo\nchuyện này cho Eadgils nhé?\nCảm ơn cậu nhiều.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3691": "Này, {#0}! Ông anh cấp trên\ncơ bắp nam tính của cậu\nđang gặp rắc rối to đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3692": "Nếu không kiếm lại được\nsố tiền đã tiêu, Con sẽ\nlại lên lớp ta một trận mất!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3693": "Vậy nên giúp ta đi, anh bạn!\nLàm mấy yêu cầu ta đăng lên ấy!\nLàm ngay đi, anh bạn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3694": "Này, {#0}! Dù đang làm gì\nhay có chuyện gì xảy ra,\ncũng đừng quên mỉm cười nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3695": "Nếu những lính đánh thuê giỏi nhất\ncứ đi khắp nơi với\nbộ mặt cau có đáng sợ...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3696": "mọi người sẽ lo lắng, mất tinh thần.\nCậu cũng có thể thua\nmột trận vốn dĩ mình thắng được.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3697": "Vậy hứa với tôi là\nsẽ luôn tươi cười nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3698": "Này, ta ghét phải cắt ngang\ncuộc điều tra ngọn tháp,\nnhưng lại có chuyện rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3699": "Ta đã cử cái cặp kỳ quặc ấy\nđi xử lý một ổ Khổng Lồ nhỏ\nmà bọn ta phát hiện...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3700": "Nhưng Lod vừa gửi báo cáo khẩn\ntừ Ngôi Đền Trên Không.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3701": "Hắn thấy viện binh Khổng Lồ\nđang tiến thẳng đến chỗ hai đứa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3702": "Hừm. Bọn Khổng Lồ\nvẫn tinh ranh như mọi khi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3703": "Nếu viện binh hợp lực với toán kia,\ncặp đôi ấy sẽ gặp\nmột trận ra trò đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3704": "Bỏ hết việc đang làm,\nđi chặn viện binh ngay.\nDiệt sạch chúng nếu có thể.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3705": "Báo cáo đã được nộp rồi.\nCậu chỉ cần trang bị và lên đường!",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::0": "Thẻ Orc",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::1": "Thẻ Orc",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::2": "Thẻ Orc",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::3": "Thẻ Orc",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::4": "Thẻ Orc",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::5": "Thẻ Orc",
    "item.cpk::it_db.en.pac::it_db_name_card.rmsg::6": "Thẻ Orc",
