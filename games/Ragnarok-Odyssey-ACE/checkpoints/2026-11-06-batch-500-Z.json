    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::0": "{#0}Dao một tay, cực kỳ lợi hại\ntrong cận chiến.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::1": "{#0}Chiếc chùy dùng trong chiến đấu.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::2": "{#0}Búa lớn chuyên dùng khi chiến đấu.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::3": "{#0}Cây cung thường được thợ săn dùng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::4": "{#0}Trượng thiết kế riêng\ncho các Pháp sư.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::5": "{#0}Đại kiếm rèn từ thép hảo hạng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::6": "{#0}Dao Katar được khắc rune độc.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::7": "{#0}Chùy được khắc rune truyền thừa.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::8": "{#0}Búa Chiến được khắc rune dũng khí.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::9": "{#0}Cung được khắc rune truyền thừa.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::10": "{#0}Trượng được khắc rune sinh lực.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::11": "{#0}Đại Kiếm được khắc rune phòng thủ.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::12": "{#0}Dao Katar được khắc rune truyền\nthừa.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::13": "{#0}Chùy được khắc rune băng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::14": "{#0}Búa Chiến được khắc rune lửa.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::15": "{#0}Cung được khắc rune chuyển động.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::16": "{#0}Trượng được khắc rune chuyển động.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::17": "{#0}Đại Kiếm được khắc rune lửa.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::18": "{#0}Dao Katar được khắc rune bội thu.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::19": "{#0}Chùy được khắc rune sinh lực.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::20": "{#0}Búa Chiến được khắc rune chuyển\nđộng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::21": "{#0}Cung Thợ Săn được khắc rune bí\ntruyền.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::22": "{#0}Trượng được khắc rune băng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::23": "{#0}Đại Kiếm được khắc rune khát vọng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::24": "{#0}Lưỡi dao sắc lẹm, chuyên\nxẻ đôi kẻ địch.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::25": "{#0}Chiếc chùy chứa ánh sáng\nbảo hộ.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::26": "{#0}Cây búa được cho là\nmang phước lành của thần linh.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::27": "{#0}Cây cung hấp thụ\nsức mạnh của mặt trăng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::28": "{#0}Cây trượng được cho là\ntăng sức mạnh người sử dụng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::29": "{#0}Thanh kiếm của đao phủ.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::30": "{#0}Lưỡi Sắc được khắc rune tài lộc.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::31": "{#0}Chùy Ánh Sáng được khắc rune độc.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::32": "{#0}Búa Aesir được khắc rune bí\ntruyền.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::33": "{#0}Cung Trăng được khắc rune sinh\nlực.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::34": "{#0}Trượng Hồn được khắc rune nước.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::35": "{#0}Kiếm Hành Quyết được khắc rune\nđộc.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::36": "{#0}Lưỡi Sắc được khắc rune nước.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::37": "{#0}Chùy Ánh Sáng được khắc rune phòng\nthủ.",
