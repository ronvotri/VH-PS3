    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::43": "{#0}Chùy Ánh Sáng được khắc rune dũng\nkhí.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::44": "{#0}Búa Aesir được khắc rune băng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::45": "{#0}Cung Trăng được khắc rune bản ngã.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::46": "{#0}Trượng Hồn được khắc rune băng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::47": "{#0}Kiếm Hành Quyết được khắc rune\nbăng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::48": "{#0}Vũ khí đáng sợ, nghe đồn\ngào thét khi thấm đẫm máu.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::49": "{#0}Chiếc chùy hình thập tự giá,\nđược thần linh ban phước.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::50": "{#0}Búa chiến làm từ vật liệu\nkhông thuộc thế giới này.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::51": "{#0}Cây cung thấm đẫm\nphép thuật của tiên tộc.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::52": "{#0}Trượng được đồn có thể\nhóa giải sức mạnh của kẻ thù.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::53": "{#0}Vũ khí huyền thoại từng\nhạ sát thần ánh sáng.",
