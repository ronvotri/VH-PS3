  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3958": "Ta vẫn chưa biết cái tòa tháp\nquái quỷ ấy có bao nhiêu tầng...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3959": "Nhưng muốn khám phá tiếp,\nta buộc phải vượt qua con rồng đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3960": "Hừm, nhìn mặt cậu là ta biết ngay!\nCậu hiểu chuyện gì sắp đến rồi.\nTốt lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3961": "Nào, {#0}! Cho con thằn lằn\nquá khổ ấy biết tay lính thuê\nmạnh nhất Đoàn Cán Cân đi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3962": "Nghe lệnh đây! Nhiệm vụ lần này:\nĐịa điểm: Tháp Yggdrasil!\nMục tiêu: Rồng Xanh Lindwurm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3964": "Tôi biết ngay chuyến này\nchẳng thể chỉ dạo chơi trong\nmột khoảng không trống rỗng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3965": "Nhưng thánh thần ơi! Tôi đâu ngờ\nlại phải đối đầu với con rồng\nchỉ có trong truyền thuyết!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3966": "Nghe này, {#0}. Con quái ấy\nlừng danh từ thời xa xưa tới giờ.\nNó mạnh kinh khủng đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3967": "Sức nó có khi ngang ngửa\ncả Đại Khổng Lồ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3968": "Nhớ chuẩn bị trang bị thật kỹ!\nĐừng để sót một sơ hở nào.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3969": "Ê, {#0}! Bọn tôi biết\ncon thằn lằn khổng lồ ấy là gì rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3970": "Tiếng gầm Sol nghe được chắc là\ncủa Rồng Xanh Lindwurm.\nMột con quái trong truyền thuyết!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3971": "Chả hiểu sao thứ chỉ có trong\ntruyện cổ lại mò xuống tận\nđáy tháp nữa...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3972": "Nhưng chuyện cần lo là làm sao\nđánh thắng nó nếu đụng độ kìa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3973": "Lif và tôi rành quái vật nhất,\nnên đã cùng nhau nghĩ ra\nmột kế hoạch.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3974": "Nghe này, rồng vừa to, vừa dữ,\nlại còn rất khôn. Người thường\nkhó mà đối phó nổi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3975": "Nhất là đừng có lao thẳng vào\nmặt nó! Đó là cách ngu ngốc\nnhất đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3976": "Móng nó sẽ xé cậu tan xác,\nhơi thở phun lửa nướng chín cậu,\nrồi nó gặm cả xương luôn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3977": "Nhưng đừng lo! Rồng hay thần,\nhễ lao vào tấn công thì kiểu gì\ncũng để lộ điểm mù.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3978": "Lách vào điểm mù rồi cứ\ntha hồ ra đòn. Thế là\ncó cơ hạ nó rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3979": "Tôi đoán điểm mù của nó nằm\nngay gốc đôi cánh to tướng.\nNói đúng hơn là hai bên sườn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3980": "Gặp Lindwurm thì áp sát sườn,\nđánh liên tục vào cánh\ncho đến khi chúng gãy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3981": "Rồng mà không bay được\nthì cũng chỉ là thằn lằn thôi.\nCứ nện vài chục phát là xong!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3982": "Rồng Xanh Lindwurm nổi tiếng lắm!\nNó bước thẳng ra từ\ntruyền thuyết cổ xưa đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3983": "Đừng có lao thẳng vào mặt nó!\nĐó là cách ngu ngốc nhất đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3984": "Móng nó sẽ xé cậu tan xác,\nhơi thở phun lửa nướng chín cậu,\nrồi nó gặm cả xương luôn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3985": "Nhưng đừng lo! Rồng hay thần,\nhễ lao vào tấn công thì kiểu gì\ncũng để lộ điểm mù.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3986": "Lách vào điểm mù rồi cứ\ntha hồ ra đòn. Thế là\ncó cơ hạ nó rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3987": "Tôi đoán điểm mù của nó nằm\nngay gốc đôi cánh to tướng.\nNói đúng hơn là hai bên sườn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3988": "Gặp Lindwurm thì áp sát sườn,\nđánh liên tục vào cánh\ncho đến khi chúng gãy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3989": "Rồng mà không bay được\nthì cũng chỉ là thằn lằn thôi.\nCứ nện vài chục phát là xong!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3990": "Hả? Làm sao bám hai bên sườn\nđủ lâu để bẻ gãy cánh nó á?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3991": "Dễ ợt!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3992": "{#0}GAN LÌ LÊN!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3993": "Thì cứ gan lên mà chịu trận!\nChứ còn cách nào khác nữa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3994": "Tôi đã tìm hiểu yêu cầu của Eirik\nvà gửi báo cáo rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3995": "Đúng như anh ấy nghi ngờ,\ntài liệu thời chư thần từng ghi\nvề một quái vật dạng thằn lằn bay.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3996": "Tiếng gầm được miêu tả\ncũng gần như khớp hoàn toàn\nvới ghi chép tôi tìm thấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3997": "Rất có thể đó là Lindwurm,\nmột con rồng vừa khổng lồ\nvừa cực kỳ hung bạo.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3998": "Lif và Eirik đang bàn cách hạ nó.\nCậu nên đến gặp một trong hai.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::3999": "Đánh rồng nguy hiểm lắm,\nnhưng tôi tin cậu sẽ trở về\nbình an, {#0}.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4000": "Vậy nên... kh-khi cậu về,\nnhớ cười thật tươi với tôi\nnhư mọi khi nhé?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4001": "Cầu Vidarr phù hộ cậu, {#0}!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4003": "Chuyện phiêu lưu hào hùng của cậu\nđã truyền cảm hứng cho tôi thử\nmột phong cách thời trang mới!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4004": "Bộ sưu tập mới mang chủ đề\n\"Dũng Sĩ Diệt Rồng Được Chọn\"!\nĐẹp đến mức tôi mê mẩn luôn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4005": "Cậu ơi, thay đồ thì cũng phải\nđổi diện mạo cho hợp chứ!\nĐến đây làm mới bản thân nào!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4006": "Ê! Mừng cậu trở về,\n{#0}, Dũng Sĩ Diệt Rồng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4007": "Nghe nói hạ con rồng xong,\nmột cơ cấu đã kích hoạt, mở\nđường xuống các tầng sâu hơn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4008": "Nhưng cậu còn được giao\nnhiệm vụ khác nữa, đúng không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4009": "Vậy việc khám phá bên dưới\nlại đổ lên đầu tôi với Sol rồi.\nChà, chắc lâu lắmmm đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4010": "Khoan đã! Cậu định xuống\ncác tầng sâu dù chẳng có\nnhiệm vụ nào bắt làm à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4011": "...Trời đất. Tôi chẳng hiểu\ncậu lấy đâu ra lắm nhiệt huyết thế!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4012": "Thôi, giúp việc tụi tôi nhanh hơn\nthì tôi hoan nghênh cả hai tay!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4013": "Nhưng đừng cố quá nhé!\nTụi tôi cần cậu giúp,\nđâu cần khiêng xác cậu về!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4014": "Thật không ngờ có người\ntự nguyện xuống các tầng sâu\ndù chẳng được giao nhiệm vụ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4015": "Đôi khi tôi chẳng hiểu\ncậu lấy đâu ra lắm nhiệt huyết thế!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4016": "Nhưng giúp xong việc sớm hơn\nthì tốt thôi. Đừng quá sức nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4017": "Chào {#0}. Trận chiến\nvới con rồng thế nào rồi?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4018": "...Ừm, ra là vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4019": "Nếu lời cậu đúng, con rồng đó\ndù rất mạnh vẫn chưa phải\nquái vật tận thế như tôi tưởng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4020": "Hoặc vì cậu đã mạnh ngang\nĐại Khổng Lồ nên mới thấy\nnó không quá đáng sợ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4021": "Nếu thế, có khi cậu còn\nđánh bại được cả quái vật\ncó sức hủy diệt thế giới.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4022": "...Mong là tôi lo xa thôi.\nNhưng tôi cứ bất an rằng\nphía trước còn kẻ địch mạnh hơn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4023": "Nếu lời cậu đúng, con rồng đó\ndù rất mạnh vẫn chưa phải\nquái vật tận thế như tôi tưởng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4024": "Ê ê, {#0}! Làm tốt lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4025": "Nghe nói bên ngoài căng lắm,\nnhưng ở pháo đài này mọi thứ\nvẫn chạy ngon lành!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4026": "Bình yên cũng thích thật.\nNhưng thế thì khẩu Gungnir này\nchẳng có dịp khai hỏa nữa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4027": "Dù đã là pháo thủ chính hiệu,\nngày nào tôi cũng làm đúng\nnhững việc như trước.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4028": "À, chào mừng {#0} trở lại.\nTa nghe cậu đã hạ được Lindwurm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4029": "Hơi đột ngột, nhưng cậu\nbáo cáo lại mọi chuyện cho ta nhé?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4030": "Ra vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4031": "Hạ Lindwurm vất vả thế\nmà chiến lợi phẩm chỉ là\ncuốn sách phép cũ kỹ này ư?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4032": "Quan trọng hơn, cậu đã tìm\nđược lối xuống sâu trong tháp.\nMột mảnh Emperium cũng phát sáng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4033": "Chà chà. Hạ được quái vật\nnguy hiểm thế, mà thành quả\nhơi khiêm tốn nhỉ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4034": "Thôi thì đành khám phá tiếp\ncho đến tận tầng đáy tháp vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4035": "Ta sẽ nhờ Học viện nghiên cứu\nxem cuốn sách này có gì đặc biệt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4036": "Trong lúc chờ tin, cậu hãy\nđể người khác thám hiểm tháp,\ncòn mình lo nhiệm vụ trên mặt đất.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4037": "Nghĩ đến chẳng vui chút nào,\nnhưng với tình hình hiện giờ...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4038": "Ta chẳng ngạc nhiên nếu\ncon quái vật lớn thứ hai, thứ ba\nlại xuất hiện đâu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4039": "Cứ nhận việc nhẹ trước đã,\nvà sẵn sàng ứng cứu khi có biến,\nrõ chưa?",
    "item.cpk::it_db.en.pac::it_db_name_weapon.rmsg::0": "{#0}Dao Katar",
