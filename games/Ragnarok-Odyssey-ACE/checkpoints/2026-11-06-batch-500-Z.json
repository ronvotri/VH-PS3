    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::39": "{#0}Cung Trăng được khắc rune bội thu.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::40": "{#0}Trượng Hồn được khắc rune lửa.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::41": "{#0}Kiếm Hành Quyết được khắc rune\nnước.",
