    "item.cpk::it_db.en.pac::it_db_name_weapon.rmsg::28": "{#0}Trượng Hồn",
    "item.cpk::it_db.en.pac::it_db_name_weapon.rmsg::29": "{#0}Kiếm Hành Quyết",
    "item.cpk::it_db.en.pac::it_db_name_weapon.rmsg::30": "{#0}Feoh Lưỡi Sắc",
