  "notes": "79 NPC and 235 crafting-order names (base families); original text and metadata preserved; stock validator run.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4723": "Thế là họ mắc kẹt, lang thang mãi\ntrong thành phố người chết.\nChẳng bao lâu, phần lớn hóa điên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4724": "Ừ, nghe thôi cũng đủ gặp ác mộng.\nNhưng cậu phải nhớ điều này:\nhọ đã mất trí rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4725": "Tôi cá họ sẽ lao vào tấn công cậu\nnhư bất kỳ con quái nào khác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4726": "Nghe kỹ đây! Nếu gặp họ, đừng\nđể lòng thương cho cảnh ngộ ấy\nlấn át lý trí, hiểu chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4727": "Nếu không, cậu sẽ phải ở lại\nNiflheim lâu hơn cậu muốn đấy.\nChuyện đó chẳng vui chút nào.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4728": "Trời đất. Tôi đã phải lo đám\nkhổng lồ, giờ thêm cả lũ vong hồn\nmất trí này nữa!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4729": "Nghe đây! Gặp linh hồn nào\nthì làm lễ tiễn họ đi là đủ,\nrõ chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4730": "Nếu để lòng thương lấn át lý trí,\ncậu sẽ phải ở lại Niflheim\nlâu hơn cậu muốn đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4731": "Tôi nghĩ mãi chẳng hiểu vì sao\nNidhoggr lại cướp linh hồn đang\nđến Asgard, rồi kéo về Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4732": "Tôi tò mò quá nên đã tìm hiểu\nchuyện này.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4733": "Hóa ra nó chỉ muốn chọc tức\ncon đại bàng trên ngọn Yggdrasil.\nHai con đó vốn chẳng ưa nhau.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4734": "Linh hồn nào vướng vào trò ác ấy\nđều phải lang thang ở Niflheim\ncho đến lúc hóa điên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4735": "Nidhoggr đúng là đồ ác độc,\nlòng dạ đen tối. Chỉ đọc về\nviệc nó làm cũng đủ khiến tôi tức.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4736": "Những linh hồn bị Nidhoggr bắt\nvẫn giữ nguyên hình dáng\nlúc họ bị bắt đi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4737": "Tôi nghĩ vì thế mà cậu sẽ\nnhận ra họ rất dễ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4738": "Chào {#0}. Hết Tháp Yggdrasil\nrồi đến Niflheim. Ngoài kia\nnghe càng lúc càng thú vị nhỉ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4739": "Cấp trên kiểm soát tin tức rất\nchặt, nên tôi chưa nhận được\nyêu cầu nào về đồ từ Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4740": "Có người hay quên tôi cũng là\nlính đánh thuê. Đã dặn giữ kín\nthì tôi giữ kín. Lẽ thường mà.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4741": "...Nhưng có một chuyện tôi muốn\nnói thật với cậu. Chỉ mình cậu\nthôi nhé. Đừng giật mình quá.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4742": "Mới đây tôi bắt gặp Ottar\nsắp bán tin mật cho mấy nhà giàu\nđể lấy cả đống Zeny.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4743": "Tất nhiên tôi chặn nó lại,\nmắng cho ù cả tai. Vậy mà\nnó còn cãi rồi kiếm cớ...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4744": "Thế là tôi cốc cho nó một cú\nrõ đau vào đầu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4745": "Nó chưa bán tin gì. Nó chỉ muốn\ntrả tôi số Zeny đã phung phí.\nĐừng kể chỉ huy nhé?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4746": "Chuyện mà lộ thì bọn tôi khỏi\nlập đoàn riêng. Còn ai tin\nbọn tôi nữa, ha ha... ha...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4747": "Ottar suýt bán tin mật Niflheim,\nnhưng nó chẳng có ý xấu.\nCậu đừng kể chỉ huy nhé?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4748": "Chuyện mà lộ thì bọn tôi khỏi\nlập đoàn riêng. Còn ai tin\nbọn tôi nữa, ha ha... ha...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4749": "A! Mừng cậu về, {#0}!\nCậu về bình an đúng như đã hứa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4750": "Sương tan rồi, giờ mình mới\nđiều tra nơi đó cho ra trò được.\nTớ biết cậu làm được mà!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4751": "Nhưng nghe Mina kể, dưới đó có\nnhiều vong hồn lắm. Chúng tìm cách\ndụ người sống nhập bọn với chúng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4752": "{#0}, cậu vừa tốt bụng\nvừa dễ tin người. Đừng để\nmấy vong hồn xấu xa lừa nhé?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4753": "Nhưng nghe Mina kể, dưới đó có\nnhiều vong hồn lắm. Chúng tìm cách\ndụ người sống nhập bọn với chúng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4754": "{#0}, cậu vừa tốt bụng\nvừa dễ tin người. Đừng để\nmấy vong hồn xấu xa lừa nhé?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4755": "Từ khi màn sương Hắc Long tạo ra\ntan đi, ta đã tiến khá đều\nở Niflheim—",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4756": "Trời đất! Có chuyện gì vậy?\nBình tĩnh, nói chậm lại nào!\nTa nghe chẳng rõ cậu nói gì.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4757": "Ánh sáng của Frigg ơi! Cậu xưa nay\ncó bao giờ nao núng. Chuyện gì\nkhiến cậu hoảng đến thế—",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4758": "{#0}... CÁI GÌ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4759": "Trong lúc thăm dò Niflheim,\nmột Kafra giống hệt Pavianne\nđã tấn công cậu sao?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4760": "Ta cứ tưởng sẽ chẳng có ngày\nđược nghe cậu kể chuyện đùa...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4761": "Nhưng cậu đâu có kiểu đùa ác\nlàm liên lụy người khác.\nCậu cũng chẳng nói dối khi báo cáo.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4762": "Pavianne vẫn ở Quầy Nhiệm Vụ\nhôm nay, như mọi khi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4763": "Hẳn cậu biết giấy tờ dồn về\nnhiều đến mức cô ấy phải ở\ntổng hành dinh suốt ngày.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4764": "Ta có thể đích thân bảo đảm.\nKafra cậu gặp ở Niflheim\nchẳng thể là Pavianne thật.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4765": "Ta đoán có thứ mượn hình dáng\ncủa cô ấy. Vậy thì đó là\nkẻ địch cần phải đánh bại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4766": "Có lẽ đó là một linh hồn mất trí\nbị Nidhoggr cướp khỏi Asgard\nrồi bỏ mặc ở thành phố người chết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4767": "Ta sẽ cho điều tra vì sao\nnó lại giống Pavianne.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4768": "Trong lúc đó, ta muốn cậu tiếp tục\nthăm dò Niflheim và tìm tung tích\nlũ khổng lồ ẩn náu ở đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4769": "...{#0}? Ta từng dặn cậu\nchuyện này rồi, nhưng vẫn\nphải nhắc lại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4770": "Dù biết thứ mang gương mặt bạn mình\nthật ra là quái vật, xuống tay\nvẫn rất khó. Ta hiểu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4771": "Nhưng cậu phải làm. Nếu chần chừ,\ncậu có thể mất mạng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4772": "Hứa với ta, bất kể trông ra sao,\nquái vật nào tấn công cậu\nthì cậu cũng phải đánh bại, nhé?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4773": "Nghe kỹ đây. Đừng để vẻ ngoài\ncủa quái vật đánh lừa. Thứ gì\ntấn công cậu thì diệt, hiểu chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4774": "Nếu không, cậu có khi thành dân\nNiflheim luôn. Lúc đó còn mặt mũi\nnào nhìn ai nữa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4776": "Lúc thăm dò Niflheim, cậu bị\nmột vong hồn giống hệt Pavianne\ntấn công sao?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4777": "Nếu nó mang dáng vẻ một nhà\nthám hiểm xa lạ, tôi đã có thể\nbiết ngay nó là thứ gì.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4778": "Đó sẽ là một linh hồn mất trí,\nbị Nidhoggr ác ý cướp đi\nkhỏi nơi an nghỉ vốn có.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4779": "Nhưng chuyện cậu kể đi ngược\nquy luật tự nhiên của thế giới.\nThú thật, tôi chưa biết nó là gì.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4780": "Tôi muốn tìm manh mối để nghiên cứu\nkỹ hơn. Cậu kể chi tiết cho tôi\nvề lần chạm trán ấy nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4781": "...Ra vậy. Có một điểm\ntrong lời cậu kể khiến tôi lo.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4782": "Con người, tỉnh táo hay mất trí,\nvẫn hành xử theo bản tính chung\nvà thói quen riêng của mình.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4783": "Thế nhưng cử chỉ và lời nói\ncủa những Kafra cậu kể dường như\nchẳng có mục đích hay ý chí gì.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4784": "Hành vi của họ thiếu tự nhiên\nđến mức tôi nghi có thế lực nào\nđó từ bên ngoài điều khiển họ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4785": "...Tôi phải nghiên cứu thêm.\nCẩn thận nhé, {#0}.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4786": "{#0}, cậu bắt đầu làm\nlính đánh thuê ngay ở Pháo Đài này.\nCậu ít có dịp giao chiến với người.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4787": "Vì thế cũng dễ hiểu nếu cậu\nngần ngại khi đối thủ mang\ngương mặt một người bạn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4788": "Chỉ nghĩ đến tiếng thét của bạn\nmình đột ngột tắt giữa chừng,\ntôi cũng chẳng muốn phải nghe.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4789": "Nhưng nếu cậu để chúng hạ mình,\nlần sau có khi chúng tôi phải\nđánh một vong hồn mang mặt cậu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4790": "Dĩ nhiên, chưa rõ khả năng\nchuyện đó xảy ra là bao nhiêu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4791": "Nhưng nếu chuyện đó xảy ra,\ntôi sẽ xin đích thân diệt hết\nmọi vong hồn dám mang mặt cậu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4792": "Tôi sẽ chẳng bao giờ để thứ gì\nmượn gương mặt cậu để gieo\nđau đớn và tang thương cho người khác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4793": "Tôi tin cậu hiểu ý tôi,\n{#0}.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4794": "Dù đau lòng đến đâu, nếu giúp\nngười khác khỏi chịu nỗi đau ấy,\ntôi sẽ tự tay cắt xiềng định mệnh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4795": "...Ít nhất, tôi tin {#0}\nmà tôi quý mến sẽ nói như vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4796": "Nếu vẫn còn băn khoăn,\ntôi nghĩ cậu nên nói với mọi người.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4797": "Có những màn sương có thể tan\nmà chẳng cần hạ rồng trước.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4798": "Ôi! {#0}, có chuyện gì vậy?\nTrông cậu buồn quá.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4799": "Nếu là chuyện công việc, cứ tìm\nPavianne hoặc Eadgils. Tớ chắc\nhọ sẽ chịu lắng nghe.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4800": "Được rồi! Màn sương chết tiệt\ntan rồi, giờ ta mới tiến được—",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4801": "Khoan, khoan! Chuyện gì thế?\nBình tĩnh, trấn tĩnh lại nào!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4802": "Mắt Đấng Toàn Phụ ơi! Bình thường\ncậu gan lì hơn ai hết. Chuyện gì\nkhiến cậu cuống lên thế—",
    "item.cpk::it_db.en.pac::it_db_name_myorder.rmsg::2928": "Halomonas Chùy Sao Mai 2-5",
