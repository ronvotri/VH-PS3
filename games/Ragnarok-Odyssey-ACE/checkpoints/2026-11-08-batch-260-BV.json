    "item.cpk::it_db.en.pac::it_db_name_charge.rmsg::2": "Giọt Yggdrasil",
    "item.cpk::it_db.en.pac::it_db_name_charge.rmsg::5": "Hoa Yggdrasil",
    "item.cpk::it_db.en.pac::it_db_name_charge.rmsg::6": "Vé Đổi Kỹ Năng Vũ Khí",
    "item.cpk::it_db.en.pac::it_db_name_charge.rmsg::7": "Vé Đổi Kỹ Năng Vũ Khí Đặc Biệt",
    "item.cpk::it_db.en.pac::it_db_name_charge.rmsg::8": "Vé Mở Rộng Trang Phục",
    "item.cpk::it_db.en.pac::it_db_name_charge.rmsg::9": "Vé Đổi Tên Nhân Vật",
    "item.cpk::it_db.en.pac::it_db_name_charge.rmsg::10": "Vé Đặt Lại Halomonas",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::22": "Chất nhầy dính.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::23": "Chất nhầy dính.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::24": "Chất nhầy dính.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::0": "Mảnh hiếm, dùng đổi vật phẩm quý\ntại Quầy Đổi Norn.\n\n《Vật phẩm chỉ có trên\nPlayStation®Store》\n\n※Vật phẩm có hạn sử dụng.\nHãy chú ý để tránh mất đồ.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::1": "Các mảnh có giá trị tương đương\nMảnh Emperium. Có thể dùng\nthay cho Mảnh Emperium.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::2": "Giọt hiếm dùng để đổi vật phẩm\nquý tại Quầy Đổi Norn.\nMỗi vật phẩm cần số Giọt khác nhau.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::3": "Loại cát cực hiếm, làm từ\nnhững mảnh Emperium nghiền mịn.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::4": "Vé dùng để quay Album Thẻ\ntại Quầy Đổi Norn. Số vé dùng\ntrong mỗi lượt quay có thể\nthay đổi loại thẻ nhận được.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::5": "Loài hoa quý giúp đặt lại\nsố lần bất tỉnh sau 3 lần.\nChỉ cần mang theo bên mình\nlà hiệu lực tự kích hoạt.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::6": "Vé cho phép đổi kỹ năng\ntrên vũ khí khi tinh luyện.\nSố vé cần dùng tùy thuộc\nvào loại vũ khí.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::7": "Vé cho phép đổi kỹ năng\ntrên vũ khí khi tinh luyện,\nchỉ tốn một vé.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::8": "Vé mở rộng sức chứa\ntrang phục mà không cần\ntốn nguyên liệu hay Zeny.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::9": "Đưa vé này cho Cuei để\nđổi tên nhân vật một lần.",
    "item.cpk::it_db.en.pac::it_db_text_charge.rmsg::10": "Dùng một vé khi nhận hoặc\nbáo cáo Đơn Chế Tạo vũ khí\nHalomonas để khôi phục\ncài đặt mặc định của vũ khí.",
    "item.cpk::it_db.en.pac::it_db_name_color.rmsg::0": "Kiểu 1",
