  "notes": "81 NPC and 419 crafting-order names (base families); original text and metadata preserved; stock validator run.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4642": "Càng xuống sâu, ma thuật của Tháp\ncàng tác động mạnh lên quái vật.\nChúng cũng càng lúc càng mạnh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4643": "Tôi có cảm giác khi tìm được\ntầng đáy, quái vật ở đó sẽ mạnh\nđến mức khó tưởng tượng nổi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4644": "Nguy nhất là nếu một sinh vật\nvốn đã mạnh như Lindwurm\nđược triệu hồi xuống tận đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4645": "Cậu hiểu chuyện đó có nghĩa gì chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4646": "Mani và tôi đã xuống khám phá\nsâu hơn ở những tầng dưới của Tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4647": "Càng xuống sâu, ma thuật của Tháp\ncàng tác động mạnh lên quái vật.\nChúng cũng càng lúc càng mạnh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4648": "Tôi có cảm giác khi tìm được\ntầng đáy, quái vật ở đó sẽ mạnh\nđến mức khó tưởng tượng nổi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4649": "Nguy nhất là nếu một sinh vật\nvốn đã mạnh như Lindwurm\nđược triệu hồi xuống tận đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4650": "Cậu hiểu chuyện đó có nghĩa gì chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4651": "Ê, {#0}! Nghe nói cậu\nđang làm mưa làm gió ngoài kia!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4652": "Hử? Chuyện ở Pháo Đài ấy à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4653": "Ờ, nhìn chung vẫn yên bình như mọi\nkhi. Nhưng tôi cứ thấy bồn chồn,\ncậu hiểu không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4654": "Tôi định báo chỉ huy mà sợ\nông ấy cười cho. Cuối cùng vẫn báo,\nvà cậu biết ông ấy nói gì không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4655": "Ông ấy bảo người từng sống sót\nqua Đại Chiến Khổng Lồ mà thấy\nbất an thì có khi đúng là có chuyện!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4656": "Ông ấy còn dặn tôi trữ thêm đạn\nở chỗ mấy khẩu pháo nhỏ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4657": "Tôi đâu có xông pha như mấy người\nvào Tháp. Vậy mà cũng thấy mình\nđang ở ngay giữa cuộc chiến ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4658": "Nói ra nghe hơi ngốc, nhưng chỉ huy\nđã nghe tôi rất nghiêm túc!\nTôi thấy vinh dự lắm. Thật đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4659": "Tháp đang có bao nhiêu chuyện,\ntôi sẽ trữ thêm đạn cho pháo nhỏ.\nĐề phòng thôi, cậu hiểu mà.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4660": "Nếu có biến, pháo thủ chính thức\nIriey đây sẽ đứng ngay tuyến đầu\nvà bắn thủng lỗ chỗ thứ đó!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4661": "Tôi cũng hơi mong có biến. Lên chức\nđến giờ tôi chưa được đánh trận\nnào! Chán chết đi được!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4662": "Mừng cậu trở về! Nhiệm vụ lớn\nthế mà cậu làm xuất sắc lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4663": "Nhờ cậu, ta có thể tiến sâu hơn\nnhiều vào Niflheim. Làm tốt lắm,\n{#0}!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4664": "Trong lúc cậu đi làm nhiệm vụ,\nchúng tôi tìm được thêm thông tin\nvề Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4665": "Càng nghe về con quái đó,\ntôi càng thấy nó đúng là\nác từ trong xương tủy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4666": "Nghe nói thỉnh thoảng\nNidhoggr lại bay ra ngoài...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4667": "Dọc đường, nó chộp linh hồn người\ntốt đang tới Valhalla hoặc Gimli\nrồi kéo họ xuống Niflheim!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4668": "Những người dũng cảm ấy lẽ ra\nđược hưởng phúc lành của Einherjar.\nVậy mà họ bị đày vào bóng tối mãi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4669": "Việc Nidhoggr làm vì thú vui tàn ác\nchưa đáng lo bằng chuyện xảy ra\nvới những linh hồn bị nó bắt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4670": "Theo giả thuyết của Học viện,\nchỉ linh hồn được định đến Helheim\nmới qua được cổng vào nơi đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4671": "Thế nên các linh hồn bị bắt\nkhông thể qua cổng,\ncũng chẳng thể quay về Asgard.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4672": "Họ phải lang thang mãi trong thành\nphố người chết ở Niflheim. Nghe nói\nphần lớn chẳng mấy chốc hóa điên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4673": "Chuyện thật đau lòng, tôi biết.\nNhưng cậu phải nhớ: những linh hồn\nấy đã mất trí rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4674": "Rất có thể họ sẽ tấn công cậu\nnhư bất cứ quái vật nào khác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4675": "Nếu gặp họ, đừng để lòng thương\ncho cảnh ngộ của họ lấn át\nlý trí của mình! Hiểu chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4676": "Bằng không, có ngày cậu cũng\nthành dân Niflheim. Lúc đó còn\nmặt mũi nào nhìn ai nữa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4677": "Nếu gặp vong hồn, đừng để lòng\nthương cho cảnh ngộ của họ lấn át\nlý trí của mình! Hiểu chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4678": "Bằng không, có ngày cậu cũng\nthành dân Niflheim. Lúc đó còn\nmặt mũi nào nhìn ai nữa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4679": "*HỨC* Nghe nói dưới âm phủ có\nđủ trò vui ha. Rồng, người chết,\nsương mù làm lú đầu, đủ cả.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4680": "Còn trên mặt đất, lũ khổng lồ\nđang thi nhau khoe tài...\nbiến mất sạch khỏi đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4681": "Lâu lắm tui chẳng thấy một cọng\nlông của tụi nó! Yên như mồ,\ntui sắp phát điên rồi! ...*HỨC*",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4682": "Hử? Cậu bảo tui hên hả?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4683": "Đúng quá, {#0}! Ha ha ha!\nMừng cảnh yên bình! CẠN LYYY!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4684": "Nhưng mà, *HỨC*, {#0} nè...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4685": "Theo kinh nghiệm của tui, yên ắng\nkiểu này là sắp có bão lớn tới mức\nchẳng đem ra kể trên bàn nhậu nổi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4686": "Tui sẽ canh mặt đất kỹ như hồi\nĐại Chiến Khổng Lồ. Cậu ở dưới đó\ncũng làm vậy, rõ chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4687": "Tui có chỗ ngồi ngon trên trời.\nVậy mà dòm kiểu gì cũng chẳng thấy\nbóng người đẹp nào trốn dưới đất.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4688": "Theo kinh nghiệm của tui, yên ắng\nkiểu này là sắp có bão lớn tới mức\nchẳng đem ra kể trên bàn nhậu nổi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4689": "Tui sẽ canh mặt đất kỹ như hồi\nĐại Chiến Khổng Lồ. Cậu ở dưới đó\ncũng làm vậy, rõ chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4690": "Tui có chỗ ngồi ngon trên trời.\nVậy mà dòm kiểu gì cũng chẳng thấy\nbóng người đẹp nào trốn dưới đất.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4691": "Vì sao Nidhoggr lại chặn bắt\nnhững linh hồn lương thiện\nđang trên đường đến Asgard?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4692": "Tò mò nên tôi đã tìm hiểu chuyện đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4693": "Hóa ra chỉ vì thù vặt. Nidhoggr\nghét con đại bàng trên ngọn\nYggdrasil nên làm vậy để chọc tức nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4694": "Những nạn nhân đáng thương của\ntrò ác ấy cứ lang thang vô định\nở Niflheim cho đến khi hóa điên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4695": "...Đó là sự báng bổ trật tự của\nthế giới này. Đọc đến đó,\ntôi đã có lúc giận sôi người.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4696": "Chỉ vì thù vặt mà Nidhoggr\nchặn bắt linh hồn đi Asgard\nrồi kéo họ xuống Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4697": "Các linh hồn ấy vẫn mang dáng vẻ\ngần giống như khi họ ở Asgard,\nnên khá dễ nhận ra.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4698": "N-này, {#0}? Dạo này Con\ncó cư xử... lạ không? Trông nó có\ngiận không? Kiểu giận lắm ấy?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4699": "T-ta đâu có giở trò nữa!\nThật! Ta thề! Ta chỉ lo\ncho em trai ta thôi mà!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4700": "Hả?! C-cậu... nghe hết rồi sao?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4701": "HẢ?! Con ngoan, nên ta không được\nlàm chuyện khiến nó buồn á?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4702": "N-này, {#0}! C-cậu đừng có\nđi tung tin bịa đấy, nghe chưa?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4703": "Con là đứa em tốt, nhưng nó...\nnó hay nói dối! Đúng! N-nên ta\nchẳng làm gì hết—",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4704": "...Nếu tái phạm thì Lính Thuê Mạnh\nNhất sẽ đấm ta bay sang kiếp sau á?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4705": "Ê!! C-cẩn thận lời nói, {#0}!\nCậu có giỏi... giỏi lắm... CỰC GIỎI\nthì cũng chẳng có cửa đấu với—",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4706": "{#0}Xin lỗi, ta xin lỗi,\nTA XIN LỖIIIIII!!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4707": "...Lại là cậu à, {#0}?\nTa hứa sẽ chẳng giở trò nữa đâu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4708": "Bị chính cậu mắng một trận\nra trò như thế, ta chỉ muốn\nchạy trốn khỏi chính mình thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4709": "Hay cứ để Con lên làm anh,\ncòn ta chịu làm... làm em...\nOAAAAAA!!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4710": "Chào {#0}!\nLại đi khám phá Niflheim à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4711": "Ai cũng bảo dưới đó hẳn\nđầy đủ loại vong hồn với\nđủ thứ kỳ quái.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4712": "Đừng để mấy vong hồn dụ cậu\nmủi lòng nhé? Có lúc cậu\ntốt bụng quá mức đấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4713": "Làm tốt lắm, {#0}!\nTốt lắm!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4714": "Nhờ cậu, giờ bọn tôi có thể\nđiều tra sâu hơn nhiều\nở Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4715": "Lúc cậu đi làm nhiệm vụ, bọn tôi\ntìm thêm được ít chuyện về\ncon thằn lằn quá khổ Nidhoggr.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4716": "Hóa ra con đó tàn bạo, hiểm độc,\nác từ trong xương tủy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4717": "Nó có một thú tiêu khiển thì phải.\nCó hôm nó bay ra ngoài...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4718": "rồi chộp linh hồn người tốt đang\ntới Asgard, Gimli hay đâu đó\nvà kéo họ xuống tận đáy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4719": "Họ lẽ ra được hưởng phúc lành\ncủa Einherjar, vậy mà nó đẩy họ\nvào bóng tối vĩnh viễn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4720": "Thú vui bệnh hoạn của con thằn lằn\nấy chẳng phải chuyện ta cần lo.\nChuyện đáng lo là số phận của họ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4721": "Theo Học viện, linh hồn chỉ vào\nđược những nơi số phận đã định\ncho họ đến.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4722": "Họ không thể vào Helheim vì\nchẳng được định đến đó. Cũng\nchẳng có đường quay về Asgard.",
    "item.cpk::it_db.en.pac::it_db_name_myorder.rmsg::2509": "Glanzen Chùy A1-2",
