    "item.cpk::it_db.en.pac::it_db_name_myorder.rmsg::2528": "Glanzen Chùy C2-3",
    "item.cpk::it_db.en.pac::it_db_name_myorder.rmsg::2529": "Glanzen Chùy C3-1",
