  "notes": "80 NPC, 320 craft recipe names (15 source base families), 100 material names; preserving source, source_tagged, ID, numbers, tokens and Japanese proper nouns; original validator.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4321": "Phép này cưỡng ép tách hồn khỏi xác,\nđưa cả hai đến Niflheim riêng rẽ,\nrồi nhập hồn lại khi tới nơi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4322": "Từ đó có thể thấy tác giả\nGaldrabok tinh thông cả phép\ntriệu hồi lẫn phép chữa trị.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4323": "Nhưng dù pháp sư ấy tài giỏi\nđến đâu, phép thuật vẫn cần\nthiết bị triệu hồi trong tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4324": "Sao ông ta biết về thiết bị ấy?\nDân Glast Heim thờ thần Vanir,\nnhững người đã dựng nên tòa tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4325": "Tôi thú thật là rất tò mò\nvề ý nghĩa của việc này đối với\ncái chết và chân tướng thế giới...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4326": "Nhưng tôi lo hơn rằng cậu cũng\ncó một người đáng để liều mạng,\nnhư vị hiệp sĩ Glast Heim kia--",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4327": "...À, ừm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4328": "Dạo này tôi mắc một thói quen\nđáng ngại: cứ buột miệng nói\nnhững điều chẳng định nói ra.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4329": "À ha! Đúng lúc lắm, {#0}!\nLod vừa gửi báo cáo khẩn\ntừ Đền Trời xuống đây.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4330": "Tưởng bọn Domovoi Trộm Cắp\nđã tản khắp Vùng Đất Chia Cắt,\nai ngờ chúng nhắm tới sa mạc Sograt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4331": "Lũ nhãi ấy cứ chăm chăm\nnhắm vào những quả táo vàng...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4332": "Vậy thì rất có thể quả cuối\nđang nằm đâu đó ngoài sa mạc!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4333": "Nghe đây! Thấy đứa nào đeo túi\nthì đừng rời mắt khỏi nó!\nBắt cho bằng được!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4334": "Phải lấy quả táo trước khi\nchúng chôm mất rồi đem về\nlàm món ăn vặt!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4335": "Trước đây ta chỉ biết sai quân\nmò kim đáy bể. Giờ có mục tiêu\nrõ ràng rồi! Khá lắm, Lod!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4336": "Nghe đây! Thấy đứa nào đeo túi\nthì đừng rời mắt khỏi nó!\nBắt cho bằng được!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4337": "Phải lấy quả táo trước khi\nchúng chôm mất rồi đem về\nlàm món ăn vặt!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4338": "Trước đây ta chỉ biết sai quân\nmò kim đáy bể. Giờ có mục tiêu\nrõ ràng rồi! Khá lắm, Lod!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4339": "Xin chào, {#0}. Chúng tôi\nđã giải mã thêm được khá nhiều\ntừ mảnh ghi chú trong Galdrabok.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4340": "Theo ghi chép, vị hiệp sĩ\nGlast Heim đã vào được Niflheim\nkhi vẫn còn sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4341": "Ông ấy kết hợp bí thuật\ntrong Galdrabok với ma lực\ntừ thiết bị triệu hồi ở tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4342": "Tác dụng thật của phép này...\nnói sao nhỉ, người yếu bóng vía\ntốt nhất đừng nghe.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4343": "Nó giật hồn ra khỏi xác,\nđưa cả hai đến Niflheim riêng,\nrồi nhét hồn trở lại thân thể.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4344": "Nói ngắn gọn, phép thành công\nnhờ đưa người dùng vào trạng thái\ngiống như đã chết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4345": "Tôi không nghĩ người tạo ra phép\nthuật này đã biết chắc\nnó sẽ thành công ngay từ đầu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4346": "Có lẽ họ còn cho rằng xác và hồn\nsẽ lạc vào hư vô, mãi mãi\nchẳng thể đoàn tụ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4347": "Nhưng vị hiệp sĩ Glast Heim\nquá khao khát gặp lại vợ,\nnên vẫn liều mình lên đường.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4348": "Nhờ ông ấy, giờ ta biết chắc\nphép thuật này thực sự\nhoạt động đúng như dự tính.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4349": "Như vậy, chúng ta đã có\nmột cách chắc chắn, hiệu quả\nđể bước vào cõi chết Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4350": "Theo ghi chép, vị hiệp sĩ\nGlast Heim đã vào được Niflheim\nkhi vẫn còn sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4351": "Ông ấy kết hợp bí thuật\ntrong Galdrabok với ma lực\ntừ thiết bị triệu hồi ở tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4352": "Phép tách hồn ra khỏi xác,\nđưa cả hai đến Niflheim riêng,\nrồi nhập hồn lại khi tới nơi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4353": "Người viết Galdrabok hẳn\nphải am hiểu sâu cả phép triệu hồi\nlẫn phép chữa trị.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4354": "Nhưng tài giỏi mấy cũng vậy,\nphép này vẫn phải nhờ\nthiết bị triệu hồi trong tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4355": "Tín đồ Vanir biết về thiết bị\nấy càng củng cố giả thuyết\nchính Vanir đã xây tòa tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4356": "Chào cậu! Hôm nay tôi có\ntin vui cực kỳ đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4357": "Nhờ mày mò nguyên liệu mới,\ntôi đã làm ra loạt mũ mới\nđể bán rồi! Hay quá phải không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4358": "Chủ đề thiết kế là\n“Số Phận Kẻ Trộm”!\nNhìn dáng là thấy quen ngay nhỉ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4359": "Ồ, chào {#0}. Có vẻ ta\nđã gom đủ những quả táo vàng rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4360": "Trong lúc cậu lo việc đó,\nchúng tôi đã bàn với Hội đồng\nvề cách xử lý Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4361": "Chuyện này hơi... rắc rối,\nnên để tôi tóm tắt cho cậu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4362": "Trước hết, Niflheim có thật không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4363": "Chúng tôi tin là có, nhưng nó\ncó giống truyền thuyết hay không\nthì lại là chuyện khác.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4364": "Điều chắc chắn là Galdrabok\nchính là chìa khóa để vào đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4365": "Trong cuộc họp Hội đồng,\nEadgils nhận được tin cực kỳ\nquan trọng từ một nguồn riêng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4366": "...Phải, vương quốc vốn có hồ sơ\ntối mật về Niflheim, chỉ vài\nnhân vật cấp cao được biết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4367": "Thuở xưa, Tháp Ảo Ảnh xuất hiện\ntrong vương quốc. Nay ta cho rằng\nnó là bóng của Tháp Yggdrasil.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4368": "Đội thám hiểm Hiệp sĩ Hoàng gia\nđã tới đó, dùng Galdrabok\ncùng một thiết bị triệu hồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4369": "Báo cáo chính thức ghi rằng\nhọ đã dịch chuyển đến Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4370": "Nhưng kẻ duy nhất trở về\nlà con bồ câu đưa tin báo rằng\nhọ đã bắt đầu thi triển phép.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4371": "Hửm? Tôi kể chuyện tối mật\ncho cậu thế này có ổn không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4372": "Không sao đâu. Chúng tôi được phép\ntiết lộ cho các thành viên\ncần biết của đoàn lính thuê.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4373": "Vả lại, chẳng thể cử ai\nvào Niflheim mà không cho\nhọ biết trước chuyện gì cả.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4374": "Chúng ta nhanh nhẹn và dày dạn\nthám hiểm vùng lạ hơn hiệp sĩ.\nĐể chúng ta đi là hợp lý.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4375": "Hơn hết, tôi thấy cậu đang\nnóng lòng tự mình xác nhận\nNiflheim có thật hay không.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4376": "Ít nhất tôi cảm thấy thế.\nTôi đoán sai à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4377": "Dù phép trong Galdrabok đã được\nxác nhận là an toàn, cậu vẫn\nsắp tới một miền đất hoàn toàn lạ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4378": "Hãy chuẩn bị thật kỹ.\nÀ, nhớ gặp Mina và Yukino\nđể nghe các ghi chép mới nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4379": "Ta chẳng biết nơi đó có gì,\nnhưng hẳn rất trái tự nhiên.\nMột chi tiết nhỏ cũng đủ đoạt mạng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4380": "Chúng ta biết phép trong\nGaldrabok an toàn, nhưng cậu vẫn\nsắp tới một miền đất xa lạ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4381": "Trước lúc đi, nhớ chuẩn bị\nthật kỹ càng nhé!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4382": "{#0}, tôi đã giải mã\nđược thêm những ghi chú mới.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4383": "Ghi chép nói thành phố người chết\nở Niflheim bị màn sương\nlàm rối loạn giác quan che phủ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4384": "Đã bước vào sương, cậu phải tìm\nvà phá nguồn sinh sương\nmới có thể tiến sâu vào thành.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4385": "Nguồn sinh ra màn sương là gì\nthì hiện vẫn chưa rõ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4386": "Tôi đang tra cứu thần thoại cổ\nxem có manh mối không.\nCó tin quan trọng tôi sẽ báo ngay.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4387": "Thành phố người chết ở Niflheim\nbị màn sương làm rối loạn\ngiác quan che phủ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4388": "Đã bước vào sương, cậu phải tìm\nvà phá nguồn sinh sương\nmới có thể tiến sâu vào thành.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4389": "Ồ, chào {#0}! Nghe nói\ncậu sắp tới thành phố người chết!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4390": "Nghe vui ghê! Cứ như đi chơi\nnhà ma siêu to khổng lồ ấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4391": "Nhưng Pavianne nghe chuyện\nthì lo lắng lắm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4392": "Rảnh thì cậu ghé nói chuyện\nvới cô ấy một chút nhé.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4393": "{#0}, cuối cùng ta cũng\nlấy được cả ba bùa táo vàng.\nTin đáng mừng đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4394": "Trong lúc cậu bận đi tìm,\nta phải họp với Hội đồng\nđể tính chuyện vùng đất ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4395": "Nghe cho kỹ! Chuyện rối như tơ,\nnên ta chỉ nói mấy ý chính thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4396": "Thứ nhất! Niflheim có thật không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4397": "Ta nghĩ là có, còn nó có giống\ntruyền thuyết hay không\nthì chưa ai dám chắc.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4398": "Thứ hai! Làm sao vào đó?\nGaldrabok! Cuốn sách nhập môn ấy\ngần như chắc chắn là chìa khóa.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4399": "Trong lúc họp Hội đồng,\nta nhận được tin rất quan trọng\nvề Niflheim từ một nguồn riêng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4400": "Hóa ra vương quốc cũng cất\nhồ sơ tối mật về nơi ấy\ntrong tầng hầm từ lâu rồi!",
    "item.cpk::it_db.en.pac::it_db_name_myorder.rmsg::1239": "Halomonas Chùy 3-4",
    "item.cpk::it_db.en.pac::it_db_name_myorder.rmsg::1240": "Halomonas Chùy 4-1",
