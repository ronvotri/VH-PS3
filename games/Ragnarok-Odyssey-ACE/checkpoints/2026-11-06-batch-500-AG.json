  "notes": "80 NPC, 151 material names, 269 crafting-order names (base families); original text and metadata preserved; stock validator run.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4481": "Ta đoán nó đang phun hết sức\nđể dùng sương nhử cậu đến.\nKhỏi phải lùng sục tìm nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4482": "...Nói thật, ta nghĩ chỉ có cậu\nmới đủ sức đứng chung chiến trường\nvới con quái vật đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4483": "Nói thật ta nghe...\nCậu nghĩ mình đánh bại nó được chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4484": "Vậy thì quyết định thế đi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4485": "Được rồi, {#0}!\nĐến lúc diệt Hắc Long,\nnguồn sương mù chắn đường ta!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4486": "Khu vực mục tiêu: “Niflheim!”\nMục tiêu: Hắc Long “Nidhoggr!!”",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4487": "Muốn tiếp tục dò tung tích\nbọn khổng lồ ở Niflheim,\nta phải dẹp hết những gì cản đường.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4488": "Ta đoán Hắc Long đang phun sương\nđủ để nhử cậu đến.\nTa khỏi phải lùng sục tìm nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4489": "Được rồi, {#0}!\nĐến lúc diệt Hắc Long,\nnguồn sương mù chắn đường ta!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4490": "Ồ, chào {#0} {#1}!\nNghe nói lần này cậu đi săn\ncon Hắc Long trong truyền thuyết!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4491": "Từ những gì ta biết qua Lục Long\nLindwurm và những truyền thuyết\nvề Hắc Long...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4492": "tôi đã cùng Eirik, chuyên gia về\nquái vật, bàn bạc và nghĩ ra\nmột kế hoạch tấn công!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4493": "Hắc Long Nidhoggr là quái vật\nngay cả trong loài rồng!\nAi cũng khiếp sợ nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4494": "Như mọi con rồng khác, vuốt, đuôi\nvà hơi thở của nó đều cực nguy hiểm!\nDính một đòn là đủ mất mạng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4495": "Nhưng đòn đáng sợ nhất đến từ\nđôi cánh đen gớm ghiếc\nvà những ấn chú tà ác trên cánh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4496": "Nghe kỹ nhé, {#0} {#1}.\nNếu cậu áp sát Nidhoggr\nnhư đã làm với Lindwurm...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4497": "cậu sẽ hứng trọn cú quật cực mạnh\ntừ cả hai cánh!\nĐau điếng đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4498": "Cậu phải canh thời điểm\nlao vào bên sườn nó\nthật, thật cẩn thận.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4499": "Rồng và những quái thú mạnh nhất\nthường chẳng có điểm yếu rõ ràng...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4500": "Nhưng sinh vật có mạnh đến mấy\ncũng phải có chỗ\nyếu hơn những chỗ khác!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4501": "Hãy dùng sự nhạy bén của lính đánh\nthuê và tin vào trực giác.\nTôi chắc cậu sẽ tìm ra cách thắng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4502": "Thử nhắm vào những bộ phận\ndễ thấy nhất của nó trước,\nrồi cứ tin vào trực giác của mình!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4503": "Hắc Long Nidhoggr là quái vật\nngay cả trong loài rồng!\nAi cũng khiếp sợ nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4504": "Như mọi con rồng khác, vuốt, đuôi\nvà hơi thở của nó đều cực nguy hiểm!\nDính một đòn là đủ mất mạng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4505": "Nhưng đòn đáng sợ nhất đến từ\nđôi cánh đen gớm ghiếc\nvà những ấn chú tà ác trên cánh.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4506": "Nghe kỹ nhé, {#0} {#1}.\nNếu cậu áp sát Nidhoggr\nnhư đã làm với Lindwurm...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4507": "cậu sẽ hứng trọn cú quật cực mạnh\ntừ cả hai cánh!\nĐau điếng đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4508": "Cậu phải canh thời điểm\nlao vào bên sườn nó\nthật, thật cẩn thận.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4509": "Rồng và những quái thú mạnh nhất\nthường chẳng có điểm yếu rõ ràng...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4510": "Nhưng sinh vật có mạnh đến mấy\ncũng phải có chỗ\nyếu hơn những chỗ khác!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4511": "Thử nhắm vào những bộ phận\ndễ thấy nhất của nó trước,\nrồi cứ tin vào trực giác của mình!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4512": "Này, {#0}? Nghe như có chuyện\nđộng trời xảy ra lúc bọn tớ\nđang đi làm nhiệm vụ ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4513": "Từ lúc bọn khổng lồ xuất hiện lại,\ntớ cứ nghĩ biết đâu chúng cũng\nxuất hiện ở Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4514": "Trời ạ... Niflheim. Niflheim thật.\nGiờ chắc muốn không tin cũng khó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4515": "Thôi vậy. Đến nước này rồi,\nmấy nơi như Valhalla có thật hay\nkhông cũng chẳng quan trọng lắm.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4516": "Điều đáng lo hơn là liệu mấy nơi đó\ncó đầy những sinh vật có thể\ntrở thành kẻ thù của ta hay không.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4517": "...TRỜI ƠI! Có lúc cậu chậm hiểu\nkinh khủng luôn ấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4518": "TỚ BẢO là bọn tớ sẽ chiến đấu\nvì cậu, đồ đầu gỗ!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4519": "Bọn tớ sẽ canh chừng bọn khổng lồ\nquanh đây, để chúng khỏi giở trò\nlàm cậu phải lo.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4520": "Cậu cứ tập trung xử đám quái vật\nở Niflheim đi, hiểu chưa?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4521": "...Nếu còn coi bọn tớ là bạn,\ncậu nhất định phải quay về, nhé?\nBọn tớ sẽ đợi cậu ở đây.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4522": "Bọn tớ sẽ canh chừng bọn khổng lồ\nquanh đây, để chúng khỏi giở trò\nlàm cậu phải lo.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4523": "Cậu cứ tập trung xử đám quái vật\nở Niflheim đi, hiểu chưa?!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4524": "Lif và tớ sẽ chiến đấu vì cậu,\nhiểu chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4525": "...Nếu còn coi bọn tớ là bạn,\ncậu nhất định phải quay về, nhé?\nBọn tớ sẽ đợi cậu ở đây.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4526": "Có thể khẳng định rằng sương mù\nbao phủ khắp thành phố người chết\nở Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4527": "Tôi đã tra nhiều thần thoại và đoán\nsương đến từ Hvergelmir, con suối\nlạnh được kể là có ở cõi ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4528": "Tôi chưa từng nghĩ Hắc Long\nmới có thể là nguồn thực sự\ncủa màn sương.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4529": "Nhờ báo cáo của cậu mà tôi mới\ntìm ra sự thật đó, {#0}.\nCảm ơn cậu.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4530": "...Nhưng tương truyền Nidhoggr\nđã sống từ thuở khai thiên lập địa\nvà sống sót qua cả Ragnarok.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4531": "Truyền thuyết kể nó gặm rễ Yggdrasil,\nnhấp máu người chết và cõng linh hồn\nnhững kẻ đã ngã xuống trên lưng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4532": "Như mọi con rồng, nó rất khôn ngoan\nvà tàn nhẫn. Hãy hết sức cẩn thận\ntrước và cả trong lúc giao chiến!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4533": "Hắc Long Nidhoggr đã sống từ thuở\nkhai thiên lập địa và sống sót\nqua cả Ragnarok.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4534": "Truyền thuyết kể nó gặm rễ Yggdrasil,\nnhấp máu người chết và cõng linh hồn\nnhững kẻ đã ngã xuống trên lưng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4535": "Như mọi con rồng, nó rất khôn ngoan\nvà tàn nhẫn. Hãy hết sức cẩn thận\ntrước và cả trong lúc giao chiến!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4536": "...Tôi tin cậu sẽ mỉm cười trở về\nnhư mọi lần, {#0}.\nChúc cậu may mắn.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4537": "Lạ là theo ghi chép của hiệp sĩ\nGlast Heim, anh ta đã vào thành phố\nngười chết mà chẳng đánh Nidhoggr.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4538": "Loài rồng có giác quan rất nhạy bén.\nKhó mà tin Nidhoggr không phát hiện\nvị hiệp sĩ đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4539": "Tôi đoán có chuyện khác\nthu hút sự chú ý của nó,\ncòn vị hiệp sĩ thì nó chẳng màng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4540": "Này, {#0}! Lần tới cậu đi hạ\nchính con Hắc Long đó hả?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4541": "Lúc đầu tớ tưởng chỉ vua chúa\nhay anh hùng huyền thoại mới được\nlàm vậy. Lính đánh thuê thì khỏi mơ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4542": "Rồi tớ chợt nhớ ra! Cậu hạ được\nVua Khổng Lồ rồi, vậy cậu cũng là\nanh hùng huyền thoại còn gì!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4543": "Thế thì cậu được chọn đi săn\nHắc Long là đúng quá rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4544": "May mắn nhé! Tớ biết cậu xử được\ncon thằn lằn đó mà!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4545": "Nghe này! Bọn tôi tìm ra\nnguồn gốc màn sương bí ẩn rồi!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4546": "Dựa vào những chi tiết\ncậu ghi trong báo cáo...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4547": "bọn tôi đã lần ra vài truyền thuyết\nkể về màn sương rất giống thế.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4548": "Có điều, thứ tạo ra màn sương ấy\ncòn kinh khủng hơn cả những gì\ntôi có thể tưởng tượng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4549": "...Cậu sẵn sàng nghe chưa?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4550": "Sương phủ Niflheim là hơi thở\ncủa Hắc Long “Nidhoggr”. Nó dùng\nmàn sương để bẫy người sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4551": "Nó phun sương khắp thành phố\nđể nhử người sống về hang,\nrồi giết họ và cướp linh hồn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4552": "Thế nên rất có thể con thằn lằn\nquá khổ đó đã biết cậu từng đến!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4553": "Bọn tôi lục hết mọi truyền thuyết\ntìm được. So với nó, Lindwurm\ntrông như thú cưng để ôm ấy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4554": "Nó sống từ thuở khai thiên lập địa,\ncòn sống sót qua cả Ragnarok!\nĐúng là con quái vật dữ hết chỗ nói.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4555": "Mắt Đấng Toàn Phụ ơi!\nCậu khiến một con quái vật như thế\nđể mắt tới mình cơ đấy!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4556": "Khổ nỗi, muốn tiếp tục dò tung tích\nbọn khổng lồ ở Niflheim thì\nbọn tôi phải hạ con đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4557": "Nó phun sương mù để nhử cậu đến.\nĐược cái bọn tôi đỡ phải\nmất công lùng nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4558": "Nghĩ kỹ thì trong số người tôi có,\nchỉ mình cậu đủ sức\nđứng cùng chiến trường với nó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4559": "Nói thật tôi nghe nhé.\nCậu nghĩ mình có cửa thắng nó không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4560": "...Tốt. Vậy quyết định thế đi.",
