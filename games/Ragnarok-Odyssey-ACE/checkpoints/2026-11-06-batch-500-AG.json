    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::280": "Vảy Mềm Lục Long",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::281": "Nước Mắt Lục Long",
    "item.cpk::it_db.en.pac::it_db_name_material.rmsg::282": "Răng Rồng Thằn Lằn",
