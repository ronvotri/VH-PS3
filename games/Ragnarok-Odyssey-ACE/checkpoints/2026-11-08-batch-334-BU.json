    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::508": "Quỷ Khổng Lồ",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::511": "Đại Lính Đánh Thuê",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::528": "Bình Minh",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::529": "Bình Minh",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::541": "Đuôi Én",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::546": "Tia Chớp",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::547": "Tia Chớp",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::548": "Tia Chớp",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::554": "Hoàng Hôn",
    "dictionary.cpk::dc_db.en.pac::dc_db_text_npc.rmsg::555": "Hoàng Hôn",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::0": "[Sao lưu]\nTải toàn bộ dữ liệu lưu lên máy chủ.\nKhông thể tải lên từng ô lưu riêng lẻ.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::1": "Đã tìm thấy bản sao lưu:\n[{#0}]\nBạn muốn ghi đè?\n\n{#1}* Không nhấn nút PS hoặc nút nguồn\nkhi đang sao lưu.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::2": "Tải dữ liệu lên máy chủ.\nTiếp tục?\n\n{#0}* Không nhấn nút PS hoặc nút nguồn\nkhi đang sao lưu.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::3": "[Thành công!]\nĐã lưu tệp sau lên máy chủ:\n\"{#0}\"",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::4": "[Lỗi!]\n{#0}Không thể tải dữ liệu lên máy chủ!",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::6": "Đang tải lên...\n{#0}* Không nhấn nút PS hoặc nút nguồn\nkhi đang sao lưu.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::7": "[Lưu ý khi sao lưu/khôi phục]\n- Phải đăng nhập PlayStation®Network.\n- Chủ sở hữu dữ liệu lưu phải đăng nhập.\n- Không thể sao lưu, khôi phục và nhập dữ liệu\n  liên tiếp.\n- Máy chủ chỉ giữ một tệp.\n- Dữ liệu của bản game mới nhất sẽ không\n  tương thích với phiên bản cũ.\n{#0}* Dữ liệu lưu có thể bị xóa trong một số\n  trường hợp.\n{#1}Xem thêm tại trang chính thức\ncủa Ragnarok Odyssey ACE.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::10": "[Khôi phục]\nTải bản sao lưu từ máy chủ về và ghi đè\ndữ liệu lưu trên máy này.\n(Lưu ý: cả bốn ô lưu đều bị ảnh hưởng!)",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::11": "Đã tìm thấy bản sao lưu:\n[{#0}]\nKhôi phục và ghi đè dữ liệu hiện tại?",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::12": "[CẢNH BÁO CUỐI CÙNG!]\nKhông thể hoàn tác thao tác này.\nBạn chắc chắn muốn dùng tệp sau ghi đè\ndữ liệu lưu hiện tại chứ?\n\"{#0}\"\n\n* Không nhấn nút PS hoặc nút nguồn\nkhi đang khôi phục.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::13": "[Thành công!]\nĐã khôi phục tệp sau từ máy chủ:\n\"{#0}\"",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::14": "{#0}[Lỗi!]\n{#1}Không tải được dữ liệu từ máy chủ!\nĐã hủy khôi phục!",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::15": "Không đủ dung lượng trống.\nCần ít nhất {#0} KB để lưu tiến trình.\nHãy xóa phần mềm khác để giải phóng bộ nhớ.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::16": "Lỗi khi lưu dữ liệu hệ thống.\nKhông thể khôi phục toàn bộ dữ liệu.\nBạn vẫn có thể chơi, nhưng có thể gặp\nsự cố trong quá trình chơi.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::17": "Lỗi khi lưu {#0}.\nKhông thể khôi phục toàn bộ dữ liệu.\nBạn vẫn có thể chơi, nhưng có thể gặp\nsự cố trong quá trình chơi.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::20": "Chưa đủ thời gian kể từ lần truy cập\nmáy chủ trước. Hãy chờ 10 phút rồi thử lại.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::21": "Máy chủ không có dữ liệu để tải xuống.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::22": "Dữ liệu trên máy chủ thuộc bản game mới hơn.\nKhông thể tải xuống.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::23": "Đang tải xuống...\n{#0}※Không nhấn nút PS hoặc nút nguồn\ncho đến khi tải/khôi phục/nhập dữ liệu xong!!",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::26": "Không tìm thấy dữ liệu lưu của phiên bản\nRagnarok Odyssey ACE đang chạy.\nKhông thể dùng tính năng này.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::28": "Đang kết nối...",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::29": "Lỗi kết nối hoặc người chơi đã hủy.\nTiến trình sao lưu sẽ đóng.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::30": "Lỗi kết nối hoặc người chơi đã hủy.\nTiến trình khôi phục sẽ đóng.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::31": "Bạn muốn kết nối trực tuyến?",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::32": "ID trực tuyến không khớp với chủ sở hữu\ndữ liệu lưu của bản Ragnarok Odyssey ACE\nđang chạy. Không thể dùng tính năng này.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::33": "Dữ liệu tải xuống không thuộc về chủ\nsở hữu đã gắn với ID trực tuyến này.\nKhông thể hoàn tất khôi phục.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::34": "Không thể sử dụng chức năng\nPlayStation®Network trong phần mềm này\ndo giới hạn độ tuổi.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::35": "Sao lưu/Khôi phục/Nhập dữ liệu đã hủy\nvì nút PS hoặc nút nguồn được nhấn.\nDữ liệu game có thể chưa chuyển hết.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::36": "Sao lưu/Khôi phục/Nhập dữ liệu đã hủy\nvì nút PS hoặc nút nguồn được nhấn.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::37": "Tệp sau có trên máy chủ nhưng không thể\nkhôi phục bằng phần mềm này:\n\"{#0}\"\nĐã hủy khôi phục.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::40": "[Lưu ý khi nhập dữ liệu lưu]\n- Phải đăng nhập PlayStation®Network.\n- Cần dữ liệu lưu của Ragnarok Odyssey.\n- Chủ sở hữu dữ liệu lưu phải đăng nhập.\n- Không thể sao lưu, khôi phục và nhập dữ liệu\n  liên tiếp.\n{#0}* Dữ liệu lưu có thể bị xóa trong một số\n  trường hợp.\n{#1}Xem thêm tại trang chính thức\ncủa Ragnarok Odyssey ACE.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::41": "[Nhập dữ liệu từ game trước]\nSẽ nhập các dữ liệu sau từ Ragnarok Odyssey:\n Thông tin nhân vật người chơi\n Thẻ vũ khí và thẻ quái vật\n{#0}※Thẻ nhận qua \"near\" hoặc đang trang bị\nsẽ không được nhập.\n{#1}(Dữ liệu từ cả 4 ô lưu sẽ được nhập.)",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::46": "[Nhập từ game trước]\nTải dữ liệu lưu Ragnarok Odyssey từ\nmáy chủ rồi ghi đè dữ liệu lưu hiện tại.\n(Dữ liệu từ cả 4 ô lưu đều được nhập.)",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::47": "Các tệp sau có trên máy chủ:\n\"{#0}\"\nTải xuống và nhập dữ liệu lưu?",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::48": "[Xác nhận cuối cùng]\nSau bước này không thể hủy thao tác.\n\"{#0}\"\nBạn muốn nhập dữ liệu lưu này?\n{#1}※KHÔNG nhấn nút PS hoặc nút nguồn\ncho đến khi tải/nhập dữ liệu xong!!",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::49": "[Thành công!!]\nĐã nhập \"{#0}\".",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::50": "[Thất bại!!]\n{#0}Không thể tải dữ liệu xuống.\nĐã hủy nhập dữ liệu từ game trước.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::51": "Không có dữ liệu lưu game trước trên máy chủ.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::52": "Lỗi kết nối trực tuyến hoặc đã hủy thao tác.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::53": "Không thể nhập dữ liệu lưu vì ID trực tuyến\ncủa dữ liệu không khớp với ID đang đăng nhập.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::54": "Máy chủ có các tệp sau, nhưng phần mềm\nhiện tại không thể nhập chúng:\n\"{#0}\"\nĐã hủy nhập từ game trước.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::55": "Không thể nhập dữ liệu lưu từ bản game trước\nvì dữ liệu không được tạo bằng phiên bản\nmới nhất của game trước.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::56": "Lỗi khi lưu dữ liệu hệ thống.\nKhông thể nhập đủ dữ liệu.\nBạn vẫn có thể chơi, nhưng có thể gặp\nsự cố trong quá trình chơi.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::57": "Lỗi khi lưu {#0}.\nKhông thể nhập đủ dữ liệu lưu.\nBạn vẫn có thể chơi, nhưng có thể gặp\nsự cố trong quá trình chơi.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::60": "{#0}[CẢNH BÁO!!]\n{#1}Bạn đã đăng xuất PlayStation®Network,\nnên không thể dùng dịch vụ trực tuyến.\nSao lưu/khôi phục/nhập dữ liệu có thể\nchưa hoàn tất. Bạn vẫn có thể chơi,\nnhưng có thể gặp sự cố.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::61": "[Tính năng Cross-Save mới]\n- Chia sẻ cùng dữ liệu lưu khi chơi\n  trên PlayStation®3 và PlayStation®Vita.\n- Cross-Save dùng cả 4 ô lưu.\n- Phải đăng nhập PlayStation®Network.\n- PlayStation®3 và PlayStation®Vita\n  phải dùng cùng ID trực tuyến.\n- PlayStation®3 và PlayStation®Vita\n  phải dùng cùng phiên bản game\n  (nên cập nhật lên bản mới nhất).",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::62": "[Tính năng Cross-Save mới]\n- Khi bật Cross-Save, bản lưu mới nhất\n  được tải lên lúc khởi động game hoặc\n  quay về màn hình tiêu đề.\n- Muốn lưu chéo sau khi chơi, hãy quay về\n  màn hình tiêu đề rồi thoát game.\n\n{#0}* Dữ liệu lưu có thể bị xóa trong một số\n  trường hợp.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::63": "{#0}・Thông báo liên quan nội dung DLC\n{#1}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::64": "[Cross-Save]\nBạn muốn đổi cài đặt Cross-Save?",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::65": "Cross-Save",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::66": "[Cross-Save]\nĐã bật tính năng Cross-Save.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::67": "[Cross-Save]\nĐã tắt tính năng Cross-Save.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::68": "[Cross-Save]\nKhông thể lưu cài đặt Cross-Save.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::70": "[Cross-Save]\nDữ liệu lưu trên máy chủ bị lỗi.\nDữ liệu lưu trên máy đã được chép lên\nmáy chủ.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::71": "[Cross-Save]\nMột máy khác đã thay đổi bản lưu\ntrên máy chủ. Bạn muốn tiếp tục bằng\nbản lưu trên máy chủ không?\n(Dữ liệu lưu trên máy sẽ bị ghi đè.)\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::72": "[Cross-Save]\nTải dữ liệu từ máy chủ về và ghi đè\nbản lưu trên máy. Bạn muốn tiếp tục?\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::73": "[Cross-Save]\nGame sẽ dùng dữ liệu lưu trên máy chủ.\n\n{#0}* Đã tải bản lưu từ máy chủ về máy.\n{#1}{#2}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::74": "[Cross-Save]\nBạn muốn tiếp tục bằng dữ liệu lưu\ntrên máy này?\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::75": "[Cross-Save]\nBạn chắc chắn muốn tải lên và ghi đè\ndữ liệu lưu trên máy chủ chứ?\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::76": "[Cross-Save]\nGame sẽ dùng dữ liệu lưu trên máy.\n\n{#0}* Đã tải dữ liệu từ máy lên máy chủ.\n{#1}{#2}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::77": "[Cross-Save]\nGame sẽ dùng dữ liệu lưu trên máy này.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::78": "[Cross-Save]\nMáy chưa có dữ liệu lưu.\nBạn muốn tải bản lưu từ máy chủ về?\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::79": "[Cross-Save]\nRagnarok Odyssey ACE sẽ dùng bản lưu\ntrên máy chủ.\n\n{#0}* Đã tải dữ liệu từ máy chủ về máy.\n{#1}{#2}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::80": "[Cross-Save]\nMáy chủ chưa có dữ liệu lưu.\nBạn muốn tải bản lưu từ máy lên không?",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::81": "[Cross-Save]\nĐã tải dữ liệu lưu lên máy chủ.\nRagnarok Odyssey ACE sẽ bắt đầu.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::82": "[Cross-Save]\nCần có Internet và đăng nhập\nPlayStation®Network mới dùng được\nCross-Save. Bạn muốn kết nối không?",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::83": "[Cross-Save]\nTiếp tục Ragnarok Odyssey ACE bằng\ndữ liệu lưu trên máy này?\n(Cross-Save đang tắt.)",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::84": "[Cross-Save]\nBạn muốn bắt đầu trò chơi mới?\n(Cross-Save đang tắt.)",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::85": "[Cross-Save]\nPhải đăng nhập PlayStation®Network\nmới dùng được Cross-Save.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::86": "(Không dùng) Thông báo Cross-Save 025",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::87": "[Cross-Save]\nĐã tải dữ liệu lưu trên máy lên máy chủ.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::88": "[Cross-Save]\nMột máy khác đã đổi dữ liệu trên máy chủ.\nBạn muốn dùng bản lưu trên máy chủ\nđể ghi đè dữ liệu trên máy?\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::89": "[Cross-Save]\nDữ liệu trên máy chủ sẽ bị ghi đè.\nBạn chắc chắn chứ?\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::90": "[Cross-Save]\nĐã tải dữ liệu lưu từ máy lên máy chủ.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::91": "[Cross-Save]\nKhông thể tải dữ liệu lưu lên máy chủ.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::92": "[Cross-Save]\nDữ liệu lưu trên máy chủ bị lỗi.\nĐã sao chép dữ liệu từ máy lên máy chủ.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::93": "[Cross-Save]\nMáy chủ có bản lưu từ một máy khác.\nBạn muốn dùng bản lưu trên máy này\nđể ghi đè bản trên máy chủ?\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::94": "[Cross-Save]\nBạn chắc chắn muốn dùng dữ liệu trên\nmáy để ghi đè dữ liệu trên máy chủ?\nDữ liệu trên máy chủ sẽ bị ghi đè.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::95": "[Cross-Save]\nĐã chép dữ liệu lưu trên máy lên máy chủ.\nCross-Save đã hoàn tất.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::96": "[Cross-Save]\nKhông thể thực hiện Cross-Save.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::97": "(Không dùng) Thông báo Cross-Save 036",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::98": "[Cross-Save]\nĐã tải dữ liệu lưu trên máy lên máy chủ.\n{#0}",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::99": "(Không dùng) Thông báo Cross-Save 038",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::100": "[Cross-Save]\nĐã xảy ra lỗi.",
    "menu.cpk::msg_common.en.pac::msg_savedata.bin::101": "Đang chép dữ liệu từ máy lên máy chủ...\n{#0}Không nhấn nút PS hoặc nút nguồn\ncho đến khi sao chép xong!!",
