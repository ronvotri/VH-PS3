    "item.cpk::it_db.en.pac::it_db_name_weapon.rmsg::449": "{#0}Rìu Cán Dài Giả F",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::420": "{#0}Dao Katar vàng rực bị\nlinh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::421": "{#0}Chùy vàng rực bị\nlinh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::422": "{#0}Búa vàng rực bị\nlinh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::423": "{#0}Cung vàng rực bị\nlinh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::424": "{#0}Trượng vàng rực bị\nlinh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::425": "{#0}Kiếm vàng rực bị\nlinh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::426": "{#0}Dao Katar hắc ám vực sâu\nbị linh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::427": "{#0}Chùy hắc ám vực sâu\nbị linh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::428": "{#0}Búa hắc ám bị Halomonas ám.\nVi khuẩn linh thể hút sức địch\nđể tăng sức mạnh của búa.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::429": "{#0}Cung hắc ám vực sâu\nbị linh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::430": "{#0}Trượng hắc ám vực sâu\nbị linh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::431": "{#0}Kiếm hắc ám vực sâu\nbị linh thể Halomonas chiếm giữ.\nNó hút sức địch để mạnh thêm.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::432": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Huyết Gầm\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::433": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Thập Tự Thần\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::434": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Búa Bradium\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::435": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Cung Tiên\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::436": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Ganbantein\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::437": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Mysteltainn\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::438": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Farbauti\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::439": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Gleipnir\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::440": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Mjollnir\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::441": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Cung Ullr\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::442": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Gridarvol\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::443": "{#0}Được Valkyrie ban phúc tại\nThánh địa Yggdrasil, Balmung\nđã thức tỉnh hết tiềm năng.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::444": "{#0}Kiếm Mặt Trời Giả đã\nnhận được sức mạnh đặc biệt.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::445": "{#0}Chùy Lưỡi Kiếm Giả đã\nnhận được sức mạnh đặc biệt.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::446": "{#0}Búa Bradium Giả đã\nnhận được sức mạnh đặc biệt.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::447": "{#0}Cung Góc Giả đã\nnhận được sức mạnh đặc biệt.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::448": "{#0}Trượng Giả đã\nnhận được sức mạnh đặc biệt.",
    "item.cpk::it_db.en.pac::it_db_text_weapon.rmsg::449": "{#0}Rìu Cán Dài Giả đã\nnhận được sức mạnh đặc biệt.",
