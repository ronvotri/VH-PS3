  "notes": "Manual Vietnamese localization, proper names and character registers preserved; no RPCS3 patch test yet.",
  "entries": {
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4241": "Trang ẩn Yukino tìm thấy có ghi chép\ncủa chủ nhân đầu tiên. Ta vẫn\nchưa giải mã được hết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4242": "Nhưng đã rõ chủ sách là hiệp sĩ\nGlast Heim thời cổ, được cử\nđến thám hiểm ngọn tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4243": "Ông tìm ra tháp ở vùng đất lạ,\nphủ đầy sương mù và bóng tối.\nÔng gọi nơi ấy là Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4244": "Có vẻ cuốn sách này chính là\nchìa khóa để bước vào đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4245": "Dù vùng đất Niflheim ấy\ngiờ không còn tồn tại nữa...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4246": "Ta vẫn phải làm rõ Galdrabok\ntrước khi kết luận chuyện đó\nlà thật hay không.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4247": "Đừng lo xa vì thứ có thể\nchỉ là ảo ảnh. Nhưng cứ\nxem đây là lời cảnh báo.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4248": "Niflheim được cho là nơi\ntổ tiên của Khổng Lồ Hắc Ám,\nvà mọi khổng lồ, ra đời.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4249": "Nếu Niflheim có thật, biết đâu\nnơi đó còn có giống khổng lồ\nchúng ta chưa từng gặp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4250": "Vậy càng phải hoàn thiện\nGaldrabok và tìm cho ra\nbí mật ẩn trong đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4251": "Ta đã cử tất cả người có thể\nđi tìm quả táo vàng cuối cùng.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4252": "Khi chuẩn bị xong, cậu cũng\nlên đường đi. Phải tìm đủ\nmảnh cuối của cuốn sách!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4253": "Niflheim được cho là quê hương\ncủa giống khổng lồ cổ, tổ tiên\ncủa Khổng Lồ Hắc Ám.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4254": "Nếu Niflheim có thật, biết đâu\nnơi đó còn có giống khổng lồ\nchúng ta chưa từng gặp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4255": "Vậy càng phải hoàn thiện\nGaldrabok và tìm cho ra\nbí mật ẩn trong đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4256": "Chúng tôi phát hiện trang ẩn\nlà ghi chép tay của người\ntừng sở hữu cuốn sách đầu tiên.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4257": "Giải mã ra mới biết ông ấy\nlà một hiệp sĩ của Glast Heim\nthời cổ đại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4258": "Ông định đến Niflheim tìm\nngười vợ đã khuất, dù bản thân\nkhi ấy vẫn còn sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4259": "Hửm? Cậu hỏi Niflheim là gì à?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4260": "Chắc cậu từng nghe những\ngiả thuyết về nơi linh hồn\nđi đến sau khi chết, phải không?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4261": "Anh hùng đến Valhalla, người\nlương thiện đến Gimli, còn\nlinh hồn tội lỗi đến Helheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4262": "Niflheim được cho là một kiểu\n\"phòng chờ\" của cõi chết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4263": "Linh hồn mang tội tụ họp\nở đó, chờ qua cánh cổng\ndẫn vào Helheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4264": "Nhiều truyền thuyết kể Ymir,\nkhổng lồ đầu tiên và tổ tiên\ncủa cả thần lẫn khổng lồ, sinh ra đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4265": "Có thể nói Niflheim nổi tiếng\nchẳng kém gì Asgard.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4266": "Trang ẩn của Galdrabok cho biết\nchủ nhân đầu tiên là hiệp sĩ\nGlast Heim thời cổ đại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4267": "Ông định đến Niflheim tìm\nngười vợ đã khuất, dù bản thân\nkhi ấy vẫn còn sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4268": "Đọc tiếp chắc sẽ biết ông ấy\nthành công hay không. Có tin gì,\ntôi sẽ báo cậu ngay.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4269": "{#0}, cậu về rồi à!\nHay quá, có tin mới\nvề Galdrabok đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4270": "Trang ẩn hình như là ghi chép\ncủa chủ nhân đầu tiên.\nBọn tôi vẫn chưa đọc hết...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4271": "Nhưng biết chắc ông ta là\nmột hiệp sĩ của Glast Heim\nđã sụp đổ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4272": "Ông ấy lên đường tới Niflheim,\nvùng đất chìm trong sương mù\nvà bóng tối.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4273": "Và cuốn sách dạy phép mỏng dính\nấy lại là chìa khóa\nđể vào đó mới ghê!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4274": "Ai biết Niflheim có thật\nhay không chứ...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4275": "Nhưng phải tìm hiểu rõ\ncuốn sách này rồi mới\nbiết câu trả lời.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4276": "Tôi chẳng thích tự rước lo,\nnhất là vì thứ chưa chắc có.\nCứ đề phòng trước thôi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4277": "Nghe nói Niflheim là nơi\nông tổ của Khổng Lồ Hắc Ám,\nà, mọi khổng lồ, chào đời!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4278": "Nếu có thật, nơi ấy chắc\nđầy những gã khổng lồ thô kệch\nmà ta chưa từng đụng độ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4279": "Thế nên càng phải mau tìm đủ\nmấy mảnh còn lại để\nhoàn thiện cuốn sách!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4280": "Tôi đã điều hết người\nđi khắp nơi săn lùng\nquả táo cuối cùng rồi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4281": "{#0}, chuẩn bị xong\nthì cậu cũng lên đường nhé!\nHoàn thiện cuốn sách nào!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4282": "Nghe nói Niflheim là nơi\nông tổ của Khổng Lồ Hắc Ám,\nà, mọi khổng lồ, chào đời!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4283": "Nếu có thật, nơi ấy chắc\nđầy những gã khổng lồ thô kệch\nmà ta chưa từng đụng độ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4284": "Thế nên càng phải mau tìm đủ\nmấy mảnh còn lại để\nhoàn thiện cuốn sách!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4285": "Chúng tôi biết trang ẩn\nlà nhật ký hành trình của\nchủ nhân đầu tiên Galdrabok.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4286": "Ông ấy là hiệp sĩ của\nGlast Heim đã sụp đổ.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4287": "Ông muốn đến Niflheim\nđón người vợ đã khuất,\ndù chính mình vẫn còn sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4288": "Hửm? Niflheim là gì ư?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4289": "Hẳn cậu cũng nghe người ta\nbàn về nơi linh hồn sẽ đến\nsau khi chết rồi chứ?",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4290": "Người dũng cảm đến Valhalla,\nngười lương thiện đến Gimli,\nkẻ mang tội đến Helheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4291": "Nhưng trước khi những linh hồn\nmang tội bước qua cổng\nđể vào Helheim...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4292": "Nghe nói họ tập trung tại\nNiflheim, như một nơi\n\"chờ đến lượt\" vậy.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4293": "Tương truyền Niflheim là\nvùng đất nguyên sơ nơi Ymir,\ntổ tiên thần và khổng lồ, ra đời.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4294": "Nó cũng là vùng đất thần thoại\nnổi tiếng chẳng kém Asgard.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4295": "Trang ẩn của Galdrabok\nlà nhật ký do hiệp sĩ\nGlast Heim xưa để lại.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4296": "Ông muốn đến Niflheim\nđón người vợ đã khuất,\ndù chính mình vẫn còn sống.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4297": "Đọc thêm chắc sẽ biết\nchuyến đi ấy ra sao.\nCó tin quan trọng, tôi sẽ báo.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4298": "{#0}! Cậu tới đúng lúc.\nLod vừa gửi một bản\nbáo cáo khẩn đây!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4299": "Ta cứ tưởng Domovoi Trộm Cắp\nđi lung tung khắp Vùng Đất\nChia Cắt. Chúng đang tới Sograt!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4300": "Với cái kiểu chúng mê mẩn\nmấy quả táo vàng đến thế...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4301": "Rất có thể quả cuối cùng\nđang nằm đâu đó\ntrong Sa mạc Sograt.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4302": "Nghe kỹ đây! Đừng để\nbất cứ Domovoi đeo túi nào\nthoát khỏi tầm mắt!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4303": "Phải giành lấy quả táo trước\nkhi chúng tha đi\nrồi định ăn luôn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4304": "Báo cáo này quý như vàng!\nTrước ta chỉ biết cử người\nđi mò, giờ đã có đích rõ ràng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4305": "Nghe kỹ đây! Đừng để\nbất cứ Domovoi đeo túi nào\nthoát khỏi tầm mắt!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4306": "Phải giành lấy quả táo trước\nkhi chúng tha đi\nrồi định ăn luôn!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4307": "Báo cáo này quý như vàng!\nTrước ta chỉ biết cử người\nđi mò, giờ đã có đích rõ ràng!",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4308": "Mừng cậu trở lại, {#0}.\nTôi đã giải mã thêm\nđược vài đoạn ghi chép.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4309": "Hiệp sĩ Glast Heim tìm ra\ncách cho người đang sống\nbước vào cõi chết Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4310": "Ông dùng bí thuật trong\nGaldrabok kết hợp với\nthiết bị triệu hồi ở Tháp.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4311": "Nhưng tác dụng của phép này\nthật sự... khiến người ta\nphải rùng mình.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4312": "Nó cưỡng ép tách hồn khỏi xác,\nđưa cả hai riêng tới Niflheim,\nrồi nhập hồn trở lại khi đến nơi.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4313": "Nói dễ hiểu, phép đưa\nngười sống vào Niflheim\nbằng cách khiến họ như đã chết.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4314": "Tôi ngờ rằng ban đầu\nchẳng ai dám chắc phép này\nsẽ hiệu nghiệm như dự đoán.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4315": "Hồn và xác có thể chẳng\nbao giờ nhập lại, mãi lạc\ngiữa hư không của các thế giới.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4316": "Nhưng hiệp sĩ ấy yêu vợ\nđến mức sẵn lòng\nchấp nhận rủi ro đó.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4317": "Nhờ lòng can đảm của ông,\nngày nay ta biết cuốn sách\nthật sự có hiệu nghiệm...",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4318": "và có thể đưa người sống\nđến Niflheim, vùng đất\ndành cho kẻ đã khuất.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4319": "Hiệp sĩ Glast Heim tìm ra\ncách cho người đang sống\nbước vào cõi chết Niflheim.",
    "menu.cpk::msg_field.en.pac::msg_npc_talk.bin::4320": "Ông dùng bí thuật trong\nGaldrabok kết hợp với\nthiết bị triệu hồi ở Tháp.",
    "item.cpk::it_db.en.pac::it_db_name_weapon.rmsg::420": "{#0}Glanzen Dao Katar",
