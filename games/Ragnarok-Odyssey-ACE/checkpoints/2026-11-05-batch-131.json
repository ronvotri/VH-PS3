    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::0": "Thuốc sắc xanh.\nHồi một ít HP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::1": "Thuốc sắc xanh.\nHồi một ít HP.\nCó thể mang thêm vào trận.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::2": "Thuốc sắc xanh.\nHồi một lượng HP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::3": "Thuốc sắc xanh.\nHồi nhiều HP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::4": "Thuốc đỏ tươi.\nHồi một ít SP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::5": "Thuốc đỏ tươi.\nHồi một ít SP.\nCó thể mang thêm vào trận.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::6": "Thuốc đỏ tươi.\nHồi một lượng SP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::7": "Thuốc đỏ tươi.\nHồi nhiều SP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::8": "Thuốc vàng nhạt.\nTăng nhẹ AP tối đa\nvà hồi một ít AP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::9": "Thuốc vàng. Tăng nhẹ\nAP tối đa, hồi một ít AP.\nCó thể mang thêm vào trận.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::10": "Thuốc vàng nhạt.\nTăng AP tối đa\nvà hồi một lượng AP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::11": "Thuốc vàng nhạt.\nTăng mạnh AP tối đa\nvà hồi nhiều AP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::12": "Thuốc sắc lam.\nHồi một ít Nhiệt huyết.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::13": "Thuốc sắc lam.\nHồi một lượng Nhiệt huyết.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::14": "Thuốc sắc lam.\nHồi nhiều Nhiệt huyết.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::15": "Thuốc giải độc.\nChữa Trúng độc\nvà Kịch độc.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::16": "Dầu xoa mát dịu.\nChữa Bỏng.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::17": "Thuốc giúp thư giãn.\nChữa Căng thẳng\nvà Thờ ơ.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::18": "Đồ uống tăng sinh lực.\nChữa Mệt mỏi.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::19": "Chữa Giảm tấn công\nvà Giảm phòng thủ.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::20": "Tạm thời ngừa Trói.\nPhải dùng trước khi bị trói.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::21": "Tạm thời ngừa Đóng băng.\nPhải dùng trước khi bị đóng băng.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::25": "Chữa mọi trạng thái bất lợi\nvà tăng kháng Trói/Đóng băng.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::26": "Thuốc tăng tập trung.\nTạm ngăn AP hao hụt.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::27": "Thuốc lạ giúp tỉnh táo.\nTạm ngăn AP hao hụt.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::28": "Linh khí thần bí, mạnh mẽ.\nGiúp tạm thời bất khả xâm phạm.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::29": "Đồ uống mằn mặn.\nTạm tăng sức tấn công.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::30": "Đồ uống mằn mặn.\nTạm tăng sức tấn công.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::31": "Đồ uống có mùi ẩm mốc.\nTạm tăng sức phòng thủ.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::32": "Đồ uống có mùi ẩm mốc.\nTạm tăng sức phòng thủ.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::33": "Khối dịch nhầy kỳ lạ.\nTăng nhẹ HP tối đa.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::34": "Khối dịch nhầy kỳ lạ.\nTăng nhẹ HP tối đa.\nCó thể mang thêm vào trận.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::35": "Khối dịch nhầy kỳ lạ.\nTăng HP tối đa.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::36": "Khối dịch nhầy kỳ lạ.\nTăng mạnh HP tối đa.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::37": "Thuốc xanh lấp lánh.\nHồi đầy HP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::38": "Thuốc đỏ lấp lánh.\nHồi đầy SP.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::39": "Thần dược từ trái cây trời.\nHồi đầy HP, chữa mọi trạng thái\nbất lợi và tăng kháng\nTrói/Đóng băng.",
    "item.cpk::it_db.en.pac::it_db_text_bottle.rmsg::40": "Thuốc lạ khiến máu sôi sục.\nTrong một khoảng thời gian,\nAP sẽ không giảm.",
